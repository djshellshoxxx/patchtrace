{
  "$defs": {
    "PackageFileIdentity": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "File Id",
          "type": "string"
        },
        "last_write_ticks": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Last Write Ticks",
          "type": "integer"
        },
        "size": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "volume_serial": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Volume Serial",
          "type": "integer"
        }
      },
      "required": [
        "volume_serial",
        "file_id",
        "size",
        "last_write_ticks"
      ],
      "title": "PackageFileIdentity",
      "type": "object"
    },
    "PackageSource": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "file_identity": {
          "$ref": "#/$defs/PackageFileIdentity"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "signature_state": {
          "const": "signature-unknown",
          "default": "signature-unknown",
          "title": "Signature State",
          "type": "string"
        },
        "size": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "source_claims": {
          "default": [],
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Source Claims",
          "type": "array"
        }
      },
      "required": [
        "sha256",
        "size",
        "file_identity",
        "display_name"
      ],
      "title": "PackageSource",
      "type": "object"
    },
    "PackageUsage": {
      "additionalProperties": false,
      "properties": {
        "callbacks": {
          "maximum": 2000000,
          "minimum": 0,
          "title": "Callbacks",
          "type": "integer"
        },
        "confirmed_output_bytes": {
          "maximum": 8589934592,
          "minimum": 0,
          "title": "Confirmed Output Bytes",
          "type": "integer"
        },
        "containers": {
          "maximum": 256,
          "minimum": 0,
          "title": "Containers",
          "type": "integer"
        },
        "elapsed_ns": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Elapsed Ns",
          "type": "integer"
        },
        "entries": {
          "maximum": 50000,
          "minimum": 0,
          "title": "Entries",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "boolean"
        },
        "failure_code": {
          "anyOf": [
            {
              "enum": [
                "PT-ACQ-INPUT",
                "PT-ACQ-LIMIT",
                "PT-ACQ-CANCEL",
                "PT-ACQ-VERIFY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Code"
        },
        "hashed_input_bytes": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Hashed Input Bytes",
          "type": "integer"
        },
        "live_allocated_bytes": {
          "maximum": 536870912,
          "minimum": 0,
          "title": "Live Allocated Bytes",
          "type": "integer"
        },
        "metadata_bytes": {
          "maximum": 33554432,
          "minimum": 0,
          "title": "Metadata Bytes",
          "type": "integer"
        },
        "peak_allocated_bytes": {
          "maximum": 536870912,
          "minimum": 0,
          "title": "Peak Allocated Bytes",
          "type": "integer"
        },
        "reserved_output_bytes": {
          "maximum": 8589934592,
          "minimum": 0,
          "title": "Reserved Output Bytes",
          "type": "integer"
        }
      },
      "required": [
        "reserved_output_bytes",
        "confirmed_output_bytes",
        "entries",
        "containers",
        "callbacks",
        "live_allocated_bytes",
        "peak_allocated_bytes",
        "hashed_input_bytes",
        "metadata_bytes",
        "elapsed_ns",
        "failed",
        "failure_code"
      ],
      "title": "PackageUsage",
      "type": "object"
    },
    "PackageWorkerBinding": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PackageSource"
        }
      },
      "required": [
        "operation_id",
        "request_id",
        "attempt_id",
        "source"
      ],
      "title": "PackageWorkerBinding",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/local-package/1/PackageWorkerReceipt.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/PackageWorkerBinding"
    },
    "contract": {
      "const": "local-package-worker/1",
      "title": "Contract",
      "type": "string"
    },
    "grant_id": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Grant Id",
      "type": "string"
    },
    "observed_ns": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Observed Ns",
      "type": "integer"
    },
    "open_entries": {
      "maximum": 50000,
      "minimum": 0,
      "title": "Open Entries",
      "type": "integer"
    },
    "parser_version": {
      "const": 1,
      "title": "Parser Version",
      "type": "integer"
    },
    "pending_outputs": {
      "maximum": 50000,
      "minimum": 0,
      "title": "Pending Outputs",
      "type": "integer"
    },
    "status": {
      "enum": [
        "complete",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/PackageUsage"
    }
  },
  "required": [
    "contract",
    "parser_version",
    "grant_id",
    "binding",
    "status",
    "observed_ns",
    "usage",
    "open_entries",
    "pending_outputs"
  ],
  "title": "PackageWorkerReceipt",
  "type": "object"
}
