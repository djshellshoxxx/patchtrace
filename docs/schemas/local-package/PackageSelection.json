{
  "$id": "https://patchtrace.local/schemas/local-package/1/PackageSelection.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ancestors": {
      "default": [],
      "items": {
        "maxLength": 64,
        "minLength": 64,
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 4,
      "title": "Ancestors",
      "type": "array"
    },
    "expected_basename": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Expected Basename",
      "type": "string"
    },
    "expected_sha256": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Sha256"
    },
    "inventory_id": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inventory Id",
      "type": "string"
    },
    "member_id": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Member Id",
      "type": "string"
    },
    "side": {
      "enum": [
        "older",
        "newer"
      ],
      "title": "Side",
      "type": "string"
    },
    "source_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    }
  },
  "required": [
    "inventory_id",
    "source_sha256",
    "member_id",
    "side",
    "expected_basename"
  ],
  "title": "PackageSelection",
  "type": "object"
}
