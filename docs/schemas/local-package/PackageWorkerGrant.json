{
  "$defs": {
    "PackageFileIdentity": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "maxLength": 32,
          "minLength": 32,
          "pattern": "^[0-9a-f]{32}$",
          "title": "File Id",
          "type": "string"
        },
        "last_write_ticks": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Last Write Ticks",
          "type": "integer"
        },
        "size": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "volume_serial": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Volume Serial",
          "type": "integer"
        }
      },
      "required": [
        "volume_serial",
        "file_id",
        "size",
        "last_write_ticks"
      ],
      "title": "PackageFileIdentity",
      "type": "object"
    },
    "PackageLimits": {
      "additionalProperties": false,
      "properties": {
        "max_callbacks": {
          "default": 2000000,
          "maximum": 2000000,
          "minimum": 1,
          "title": "Max Callbacks",
          "type": "integer"
        },
        "max_containers": {
          "default": 256,
          "maximum": 256,
          "minimum": 1,
          "title": "Max Containers",
          "type": "integer"
        },
        "max_depth": {
          "default": 4,
          "maximum": 4,
          "minimum": 0,
          "title": "Max Depth",
          "type": "integer"
        },
        "max_diagnostics": {
          "default": 1000,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Diagnostics",
          "type": "integer"
        },
        "max_entries": {
          "default": 50000,
          "maximum": 50000,
          "minimum": 1,
          "title": "Max Entries",
          "type": "integer"
        },
        "max_entry_bytes": {
          "default": 1073741824,
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Max Entry Bytes",
          "type": "integer"
        },
        "max_expanded_bytes": {
          "default": 8589934592,
          "maximum": 8589934592,
          "minimum": 1,
          "title": "Max Expanded Bytes",
          "type": "integer"
        },
        "max_json_bytes": {
          "default": 67108864,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max Json Bytes",
          "type": "integer"
        },
        "max_live_allocation_bytes": {
          "default": 536870912,
          "maximum": 536870912,
          "minimum": 1,
          "title": "Max Live Allocation Bytes",
          "type": "integer"
        },
        "max_metadata_bytes": {
          "default": 33554432,
          "maximum": 33554432,
          "minimum": 1,
          "title": "Max Metadata Bytes",
          "type": "integer"
        },
        "max_name_bytes": {
          "default": 1024,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Name Bytes",
          "type": "integer"
        },
        "max_process_bytes": {
          "default": 1073741824,
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Max Process Bytes",
          "type": "integer"
        },
        "max_seconds": {
          "default": 1800,
          "maximum": 1800,
          "minimum": 1,
          "title": "Max Seconds",
          "type": "integer"
        },
        "max_source_bytes": {
          "default": 2147483647,
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Max Source Bytes",
          "type": "integer"
        },
        "max_xml_bytes": {
          "default": 2097152,
          "maximum": 2097152,
          "minimum": 1,
          "title": "Max Xml Bytes",
          "type": "integer"
        }
      },
      "title": "PackageLimits",
      "type": "object"
    },
    "PackageSource": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "file_identity": {
          "$ref": "#/$defs/PackageFileIdentity"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "signature_state": {
          "const": "signature-unknown",
          "default": "signature-unknown",
          "title": "Signature State",
          "type": "string"
        },
        "size": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "source_claims": {
          "default": [],
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Source Claims",
          "type": "array"
        }
      },
      "required": [
        "sha256",
        "size",
        "file_identity",
        "display_name"
      ],
      "title": "PackageSource",
      "type": "object"
    },
    "PackageUsage": {
      "additionalProperties": false,
      "properties": {
        "callbacks": {
          "maximum": 2000000,
          "minimum": 0,
          "title": "Callbacks",
          "type": "integer"
        },
        "confirmed_output_bytes": {
          "maximum": 8589934592,
          "minimum": 0,
          "title": "Confirmed Output Bytes",
          "type": "integer"
        },
        "containers": {
          "maximum": 256,
          "minimum": 0,
          "title": "Containers",
          "type": "integer"
        },
        "elapsed_ns": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Elapsed Ns",
          "type": "integer"
        },
        "entries": {
          "maximum": 50000,
          "minimum": 0,
          "title": "Entries",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "boolean"
        },
        "failure_code": {
          "anyOf": [
            {
              "enum": [
                "PT-ACQ-INPUT",
                "PT-ACQ-LIMIT",
                "PT-ACQ-CANCEL",
                "PT-ACQ-VERIFY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Code"
        },
        "hashed_input_bytes": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Hashed Input Bytes",
          "type": "integer"
        },
        "live_allocated_bytes": {
          "maximum": 536870912,
          "minimum": 0,
          "title": "Live Allocated Bytes",
          "type": "integer"
        },
        "metadata_bytes": {
          "maximum": 33554432,
          "minimum": 0,
          "title": "Metadata Bytes",
          "type": "integer"
        },
        "peak_allocated_bytes": {
          "maximum": 536870912,
          "minimum": 0,
          "title": "Peak Allocated Bytes",
          "type": "integer"
        },
        "reserved_output_bytes": {
          "maximum": 8589934592,
          "minimum": 0,
          "title": "Reserved Output Bytes",
          "type": "integer"
        }
      },
      "required": [
        "reserved_output_bytes",
        "confirmed_output_bytes",
        "entries",
        "containers",
        "callbacks",
        "live_allocated_bytes",
        "peak_allocated_bytes",
        "hashed_input_bytes",
        "metadata_bytes",
        "elapsed_ns",
        "failed",
        "failure_code"
      ],
      "title": "PackageUsage",
      "type": "object"
    },
    "PackageWorkerBinding": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/PackageSource"
        }
      },
      "required": [
        "operation_id",
        "request_id",
        "attempt_id",
        "source"
      ],
      "title": "PackageWorkerBinding",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/local-package/1/PackageWorkerGrant.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline": {
      "$ref": "#/$defs/PackageUsage"
    },
    "binding": {
      "$ref": "#/$defs/PackageWorkerBinding"
    },
    "contract": {
      "const": "local-package-worker/1",
      "title": "Contract",
      "type": "string"
    },
    "deadline_ns": {
      "maximum": 18446744073709551615,
      "minimum": 1,
      "title": "Deadline Ns",
      "type": "integer"
    },
    "grant_id": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Grant Id",
      "type": "string"
    },
    "grant_nonce": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Grant Nonce",
      "type": "string"
    },
    "issued_ns": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Issued Ns",
      "type": "integer"
    },
    "limits": {
      "$ref": "#/$defs/PackageLimits"
    },
    "parser_version": {
      "const": 1,
      "title": "Parser Version",
      "type": "integer"
    },
    "started_ns": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Started Ns",
      "type": "integer"
    }
  },
  "required": [
    "contract",
    "parser_version",
    "grant_id",
    "grant_nonce",
    "binding",
    "limits",
    "started_ns",
    "deadline_ns",
    "issued_ns",
    "baseline"
  ],
  "title": "PackageWorkerGrant",
  "type": "object"
}
