{
  "$defs": {
    "CellResult": {
      "additionalProperties": false,
      "properties": {
        "elapsed_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "hits": {
          "default": 0,
          "minimum": 0,
          "title": "Hits",
          "type": "integer"
        },
        "offsets": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Offsets",
          "type": "array"
        },
        "reason": {
          "default": "",
          "maxLength": 512,
          "title": "Reason",
          "type": "string"
        },
        "rule_name": {
          "maxLength": 256,
          "title": "Rule Name",
          "type": "string"
        },
        "rvas": {
          "default": [],
          "items": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Rvas",
          "type": "array"
        },
        "state": {
          "enum": [
            "hit",
            "no-hit",
            "not-scanned",
            "timeout",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "verdict": {
          "default": "unscored",
          "enum": [
            "as-expected",
            "unexpected-hit",
            "unexpected-miss",
            "unscored"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "rule_name",
        "target_id",
        "state"
      ],
      "title": "CellResult",
      "type": "object"
    },
    "EngineStamp": {
      "additionalProperties": false,
      "properties": {
        "decoder": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Decoder",
          "type": "string"
        },
        "decoder_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Decoder Version",
          "type": "string"
        },
        "engine": {
          "const": "yara-x",
          "default": "yara-x",
          "title": "Engine",
          "type": "string"
        },
        "grammar": {
          "const": "yrx-gen/1",
          "default": "yrx-gen/1",
          "title": "Grammar",
          "type": "string"
        },
        "version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "version_source": {
          "enum": [
            "metadata",
            "pin"
          ],
          "title": "Version Source",
          "type": "string"
        },
        "worker": {
          "const": "rules-worker/1",
          "default": "rules-worker/1",
          "title": "Worker",
          "type": "string"
        }
      },
      "required": [
        "version",
        "version_source",
        "decoder",
        "decoder_version"
      ],
      "title": "EngineStamp",
      "type": "object"
    },
    "LintFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 512,
          "title": "Message",
          "type": "string"
        },
        "rule_name": {
          "maxLength": 256,
          "title": "Rule Name",
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "rule_name",
        "code",
        "severity",
        "message"
      ],
      "title": "LintFinding",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/yarax/1/WorkerResult.json",
  "additionalProperties": false,
  "properties": {
    "cells": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CellResult"
      },
      "maxItems": 105000,
      "title": "Cells",
      "type": "array"
    },
    "engine": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngineStamp"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "PT-RULE-ENGINE",
            "PT-RULE-TIMEOUT",
            "PT-RULE-CANCEL",
            "PT-RULE-COMPILE",
            "PT-RULE-UNAVAILABLE"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "kind": {
      "enum": [
        "ok",
        "error"
      ],
      "title": "Kind",
      "type": "string"
    },
    "lint": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LintFinding"
      },
      "title": "Lint",
      "type": "array"
    },
    "message": {
      "default": "",
      "maxLength": 8192,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "kind"
  ],
  "title": "WorkerResult",
  "type": "object"
}
