{
  "$defs": {
    "CellResult": {
      "additionalProperties": false,
      "properties": {
        "elapsed_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "hits": {
          "default": 0,
          "minimum": 0,
          "title": "Hits",
          "type": "integer"
        },
        "offsets": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Offsets",
          "type": "array"
        },
        "reason": {
          "default": "",
          "maxLength": 512,
          "title": "Reason",
          "type": "string"
        },
        "rule_name": {
          "maxLength": 256,
          "title": "Rule Name",
          "type": "string"
        },
        "rvas": {
          "default": [],
          "items": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Rvas",
          "type": "array"
        },
        "state": {
          "enum": [
            "hit",
            "no-hit",
            "not-scanned",
            "timeout",
            "error"
          ],
          "title": "State",
          "type": "string"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "verdict": {
          "default": "unscored",
          "enum": [
            "as-expected",
            "unexpected-hit",
            "unexpected-miss",
            "unscored"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "rule_name",
        "target_id",
        "state"
      ],
      "title": "CellResult",
      "type": "object"
    },
    "EngineStamp": {
      "additionalProperties": false,
      "properties": {
        "decoder": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Decoder",
          "type": "string"
        },
        "decoder_version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Decoder Version",
          "type": "string"
        },
        "engine": {
          "const": "yara-x",
          "default": "yara-x",
          "title": "Engine",
          "type": "string"
        },
        "grammar": {
          "const": "yrx-gen/1",
          "default": "yrx-gen/1",
          "title": "Grammar",
          "type": "string"
        },
        "version": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "version_source": {
          "enum": [
            "metadata",
            "pin"
          ],
          "title": "Version Source",
          "type": "string"
        },
        "worker": {
          "const": "rules-worker/1",
          "default": "rules-worker/1",
          "title": "Worker",
          "type": "string"
        }
      },
      "required": [
        "version",
        "version_source",
        "decoder",
        "decoder_version"
      ],
      "title": "EngineStamp",
      "type": "object"
    },
    "TargetRef": {
      "additionalProperties": false,
      "properties": {
        "advisory_says": {
          "default": "",
          "maxLength": 512,
          "title": "Advisory Says",
          "type": "string"
        },
        "expect": {
          "default": "unknown",
          "enum": [
            "hit",
            "no-hit",
            "unknown"
          ],
          "title": "Expect",
          "type": "string"
        },
        "file_version": {
          "default": "",
          "maxLength": 64,
          "title": "File Version",
          "type": "string"
        },
        "kb": {
          "default": [],
          "items": {
            "pattern": "^KB\\d{6,8}$",
            "type": "string"
          },
          "title": "Kb",
          "type": "array"
        },
        "label": {
          "default": "",
          "maxLength": 120,
          "title": "Label",
          "type": "string"
        },
        "ordinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ordinal"
        },
        "role": {
          "enum": [
            "older-anchor",
            "newer-anchor",
            "series",
            "extra",
            "clean",
            "control"
          ],
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 134217728,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "target_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "toolchain_flag": {
          "default": false,
          "title": "Toolchain Flag",
          "type": "boolean"
        }
      },
      "required": [
        "target_id",
        "role",
        "sha256",
        "size"
      ],
      "title": "TargetRef",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/yarax/1/MatrixRun.json",
  "additionalProperties": false,
  "properties": {
    "anomalies": {
      "default": [],
      "items": {
        "maxLength": 512,
        "type": "string"
      },
      "title": "Anomalies",
      "type": "array"
    },
    "cache_key": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cache Key",
      "type": "string"
    },
    "cells": {
      "items": {
        "$ref": "#/$defs/CellResult"
      },
      "maxItems": 105000,
      "title": "Cells",
      "type": "array"
    },
    "engine": {
      "$ref": "#/$defs/EngineStamp"
    },
    "limits": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Limits",
      "type": "object"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "cancelled",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "targets": {
      "items": {
        "$ref": "#/$defs/TargetRef"
      },
      "title": "Targets",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "cache_key",
    "engine",
    "status",
    "targets",
    "cells",
    "limits"
  ],
  "title": "MatrixRun",
  "type": "object"
}
