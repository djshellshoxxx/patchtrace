{
  "$id": "https://patchtrace.local/schemas/yarax/1/CellResult.json",
  "additionalProperties": false,
  "properties": {
    "elapsed_ms": {
      "default": 0,
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "integer"
    },
    "hits": {
      "default": 0,
      "minimum": 0,
      "title": "Hits",
      "type": "integer"
    },
    "offsets": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "maxItems": 8,
      "title": "Offsets",
      "type": "array"
    },
    "reason": {
      "default": "",
      "maxLength": 512,
      "title": "Reason",
      "type": "string"
    },
    "rule_name": {
      "maxLength": 256,
      "title": "Rule Name",
      "type": "string"
    },
    "rvas": {
      "default": [],
      "items": {
        "maximum": 4294967295,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 8,
      "title": "Rvas",
      "type": "array"
    },
    "state": {
      "enum": [
        "hit",
        "no-hit",
        "not-scanned",
        "timeout",
        "error"
      ],
      "title": "State",
      "type": "string"
    },
    "target_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "verdict": {
      "default": "unscored",
      "enum": [
        "as-expected",
        "unexpected-hit",
        "unexpected-miss",
        "unscored"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "rule_name",
    "target_id",
    "state"
  ],
  "title": "CellResult",
  "type": "object"
}
