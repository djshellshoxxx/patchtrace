{
  "$defs": {
    "FunctionRef": {
      "additionalProperties": false,
      "properties": {
        "extent": {
          "enum": [
            "pdata",
            "unified-ir",
            "unknown"
          ],
          "title": "Extent",
          "type": "string"
        },
        "name": {
          "default": "",
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "rva": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Rva",
          "type": "integer"
        },
        "size": {
          "maximum": 65536,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "rva",
        "size",
        "extent"
      ],
      "title": "FunctionRef",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/yarax/1/PairSource.json",
  "additionalProperties": false,
  "properties": {
    "analyst_confirmed_material": {
      "default": false,
      "title": "Analyst Confirmed Material",
      "type": "boolean"
    },
    "category": {
      "enum": [
        "modified",
        "added",
        "removed"
      ],
      "title": "Category",
      "type": "string"
    },
    "cwe": {
      "default": [],
      "items": {
        "pattern": "^CWE-\\d{1,5}$",
        "type": "string"
      },
      "title": "Cwe",
      "type": "array"
    },
    "finding_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finding Id"
    },
    "match_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Match Id",
      "type": "string"
    },
    "materiality": {
      "maxLength": 512,
      "title": "Materiality",
      "type": "string"
    },
    "newer": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "newer_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Newer Sha256",
      "type": "string"
    },
    "older": {
      "anyOf": [
        {
          "$ref": "#/$defs/FunctionRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "older_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Older Sha256",
      "type": "string"
    },
    "project_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "review": {
      "const": "accepted",
      "default": "accepted",
      "title": "Review",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "revision",
    "run_id",
    "older_sha256",
    "newer_sha256",
    "match_id",
    "category",
    "materiality"
  ],
  "title": "PairSource",
  "type": "object"
}
