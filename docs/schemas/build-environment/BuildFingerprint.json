{
  "$defs": {
    "BuildFact": {
      "additionalProperties": false,
      "properties": {
        "certainty": {
          "enum": [
            "exact-field",
            "derived",
            "signature",
            "heuristic",
            "unknown"
          ],
          "title": "Certainty",
          "type": "string"
        },
        "key": {
          "enum": [
            "compiler",
            "compiler_version",
            "linker",
            "linker_field",
            "linker_rich",
            "build_tool",
            "runtime_family",
            "language",
            "target_os",
            "subsystem",
            "os_version_field",
            "subsystem_version_field",
            "image_version_field",
            "rich_signature",
            "packer",
            "protector",
            "installer",
            "obfuscator",
            "managed",
            "gs_cookie",
            "cfg",
            "aslr",
            "repro",
            "debug_entry_types",
            "entropy_exec",
            "overlay"
          ],
          "title": "Key",
          "type": "string"
        },
        "raw": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "maxLength": 120,
                "type": "string"
              }
            ],
            "type": "array"
          },
          "maxItems": 4,
          "title": "Raw",
          "type": "array"
        },
        "ref": {
          "default": "",
          "maxLength": 64,
          "title": "Ref",
          "type": "string"
        },
        "source": {
          "enum": [
            "pe-header",
            "rich-header",
            "debug-directory",
            "load-config",
            "imports",
            "clr-header",
            "sections",
            "diec"
          ],
          "title": "Source",
          "type": "string"
        },
        "value": {
          "maxLength": 200,
          "title": "Value",
          "type": "string"
        },
        "version": {
          "default": "",
          "maxLength": 120,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "source",
        "certainty"
      ],
      "title": "BuildFact",
      "type": "object"
    },
    "BuiltFrom": {
      "additionalProperties": false,
      "properties": {
        "die_cache_key": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Die Cache Key"
        },
        "fingerprint_version": {
          "const": "buildenv/1",
          "default": "buildenv/1",
          "title": "Fingerprint Version",
          "type": "string"
        },
        "pe_facts_version": {
          "maxLength": 32,
          "title": "Pe Facts Version",
          "type": "string"
        }
      },
      "required": [
        "pe_facts_version",
        "die_cache_key"
      ],
      "title": "BuiltFrom",
      "type": "object"
    },
    "ClrFacts": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "items": {
            "maxLength": 32,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Flags",
          "type": "array"
        },
        "has_native_header": {
          "title": "Has Native Header",
          "type": "boolean"
        },
        "header_size": {
          "minimum": 0,
          "title": "Header Size",
          "type": "integer"
        },
        "il_only": {
          "title": "Il Only",
          "type": "boolean"
        },
        "metadata_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metadata Version"
        },
        "runtime_major": {
          "minimum": 0,
          "title": "Runtime Major",
          "type": "integer"
        },
        "runtime_minor": {
          "minimum": 0,
          "title": "Runtime Minor",
          "type": "integer"
        }
      },
      "required": [
        "header_size",
        "runtime_major",
        "runtime_minor",
        "flags",
        "il_only",
        "has_native_header",
        "metadata_version"
      ],
      "title": "ClrFacts",
      "type": "object"
    },
    "DieSummary": {
      "additionalProperties": false,
      "description": "What the stored `diec` run says about itself; the evidence rows are only read.",
      "properties": {
        "argv_version": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Argv Version"
        },
        "cache_key": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Key"
        },
        "db_label": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Db Label"
        },
        "db_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Db Sha256"
        },
        "heuristics": {
          "title": "Heuristics",
          "type": "boolean"
        },
        "run_id": {
          "maxLength": 128,
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "none-found",
            "failed",
            "timeout",
            "cancelled",
            "unsupported",
            "absent",
            "not-run"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tool Version"
        }
      },
      "required": [
        "status",
        "run_id",
        "tool_version",
        "db_label",
        "db_sha256",
        "argv_version",
        "heuristics",
        "cache_key"
      ],
      "title": "DieSummary",
      "type": "object"
    },
    "PeBuildFacts": {
      "additionalProperties": false,
      "description": "Header-level facts of one PE (mirror of `pe_overview.build_facts.PeBuildFacts`, which stays stdlib).",
      "properties": {
        "anomalies": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Anomalies",
          "type": "array"
        },
        "clr": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClrFacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "debug_entry_types": {
          "items": {
            "type": "integer"
          },
          "maxItems": 16,
          "title": "Debug Entry Types",
          "type": "array"
        },
        "dll_characteristics": {
          "items": {
            "maxLength": 32,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Dll Characteristics",
          "type": "array"
        },
        "entropy_exec_max": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entropy Exec Max"
        },
        "facts_version": {
          "const": "pe-build-facts/1",
          "default": "pe-build-facts/1",
          "title": "Facts Version",
          "type": "string"
        },
        "guard_flags": {
          "anyOf": [
            {
              "items": {
                "maxLength": 48,
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Guard Flags"
        },
        "image_field": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image Field"
        },
        "linker_field": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Linker Field"
        },
        "os_field": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Os Field"
        },
        "overlay_entropy": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Overlay Entropy"
        },
        "overlay_size": {
          "minimum": 0,
          "title": "Overlay Size",
          "type": "integer"
        },
        "repro": {
          "title": "Repro",
          "type": "boolean"
        },
        "rich": {
          "anyOf": [
            {
              "$ref": "#/$defs/RichFacts"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_families": {
          "items": {
            "maxLength": 32,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Runtime Families",
          "type": "array"
        },
        "sampled": {
          "title": "Sampled",
          "type": "boolean"
        },
        "security_cookie_set": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Security Cookie Set"
        },
        "subsystem": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subsystem"
        },
        "subsystem_field": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "maximum": 65535,
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subsystem Field"
        }
      },
      "required": [
        "linker_field",
        "os_field",
        "image_field",
        "subsystem_field",
        "subsystem",
        "dll_characteristics",
        "guard_flags",
        "security_cookie_set",
        "debug_entry_types",
        "repro",
        "rich",
        "clr",
        "runtime_families",
        "entropy_exec_max",
        "overlay_size",
        "overlay_entropy",
        "sampled",
        "anomalies"
      ],
      "title": "PeBuildFacts",
      "type": "object"
    },
    "RichEntry": {
      "additionalProperties": false,
      "properties": {
        "build": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Build",
          "type": "integer"
        },
        "count": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "product_id": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Product Id",
          "type": "integer"
        }
      },
      "required": [
        "product_id",
        "build",
        "count"
      ],
      "title": "RichEntry",
      "type": "object"
    },
    "RichFacts": {
      "additionalProperties": false,
      "properties": {
        "checksum_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Checksum Ok"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/RichEntry"
          },
          "maxItems": 1024,
          "title": "Entries",
          "type": "array"
        },
        "key": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Key",
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "signature": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signature",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "offset",
        "key",
        "checksum_ok",
        "entries",
        "truncated",
        "signature"
      ],
      "title": "RichFacts",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/build-environment/1/BuildFingerprint.json",
  "additionalProperties": false,
  "properties": {
    "anomalies": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Anomalies",
      "type": "array"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "built_from": {
      "$ref": "#/$defs/BuiltFrom"
    },
    "contract": {
      "const": "build-environment/1",
      "default": "build-environment/1",
      "title": "Contract",
      "type": "string"
    },
    "die": {
      "anyOf": [
        {
          "$ref": "#/$defs/DieSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/BuildFact"
      },
      "maxItems": 128,
      "title": "Facts",
      "type": "array"
    },
    "pe": {
      "anyOf": [
        {
          "$ref": "#/$defs/PeBuildFacts"
        },
        {
          "type": "null"
        }
      ]
    },
    "side": {
      "enum": [
        "older",
        "newer"
      ],
      "title": "Side",
      "type": "string"
    }
  },
  "required": [
    "artifact_sha256",
    "side",
    "pe",
    "die",
    "facts",
    "anomalies",
    "built_from"
  ],
  "title": "BuildFingerprint",
  "type": "object"
}
