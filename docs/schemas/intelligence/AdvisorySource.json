{
  "$id": "https://patchtrace.local/schemas/intelligence/1/AdvisorySource.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One acquisition of exact bytes. ``source_id`` is the content SHA-256; ``retrieval_id`` the event.",
  "properties": {
    "authenticity_state": {
      "enum": [
        "unverified-local-file",
        "tls-allowlisted-host",
        "tls-allowlisted-host-hash-match"
      ],
      "title": "Authenticity State",
      "type": "string"
    },
    "contract": {
      "const": "intelligence/1",
      "default": "intelligence/1",
      "title": "Contract",
      "type": "string"
    },
    "current_release_date": {
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Current Release Date",
      "type": "string"
    },
    "document_category": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Document Category",
      "type": "string"
    },
    "file_name": {
      "maxLength": 255,
      "minLength": 1,
      "title": "File Name",
      "type": "string"
    },
    "filename_matches_tracking_id": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filename Matches Tracking Id"
    },
    "initial_release_date": {
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Initial Release Date",
      "type": "string"
    },
    "origin": {
      "enum": [
        "local-import",
        "https-fetch"
      ],
      "title": "Origin",
      "type": "string"
    },
    "publisher_category": {
      "enum": [
        "coordinator",
        "discoverer",
        "other",
        "translator",
        "user",
        "vendor"
      ],
      "title": "Publisher Category",
      "type": "string"
    },
    "publisher_name": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Publisher Name",
      "type": "string"
    },
    "publisher_namespace": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Publisher Namespace",
      "type": "string"
    },
    "raw_path": {
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^intelligence/csaf/sources/[0-9a-f]{64}\\.json$",
      "title": "Raw Path",
      "type": "string"
    },
    "retrieval_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Retrieval Id",
      "type": "string"
    },
    "retrieved_at": {
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Retrieved At",
      "type": "string"
    },
    "revision": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "self_urls": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Self Urls",
      "type": "array"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "signature_state": {
      "const": "not-checked",
      "default": "not-checked",
      "title": "Signature State",
      "type": "string"
    },
    "size": {
      "maximum": 16777216,
      "minimum": 1,
      "title": "Size",
      "type": "integer"
    },
    "source_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Id",
      "type": "string"
    },
    "tracking_id": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Tracking Id",
      "type": "string"
    },
    "tracking_status": {
      "enum": [
        "draft",
        "final",
        "interim"
      ],
      "title": "Tracking Status",
      "type": "string"
    },
    "uri": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uri"
    }
  },
  "required": [
    "source_id",
    "retrieval_id",
    "origin",
    "file_name",
    "retrieved_at",
    "sha256",
    "size",
    "tracking_id",
    "revision",
    "tracking_status",
    "initial_release_date",
    "current_release_date",
    "schema_version",
    "document_category",
    "publisher_name",
    "publisher_namespace",
    "publisher_category",
    "authenticity_state",
    "raw_path"
  ],
  "title": "AdvisorySource",
  "type": "object"
}
