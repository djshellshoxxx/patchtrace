{
  "$defs": {
    "BranchStep": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "architecture",
            "host_name",
            "language",
            "legacy",
            "patch_level",
            "product_family",
            "product_name",
            "product_version",
            "product_version_range",
            "service_pack",
            "specification",
            "vendor"
          ],
          "title": "Category",
          "type": "string"
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "category",
        "name"
      ],
      "title": "BranchStep",
      "type": "object"
    },
    "CVEFact": {
      "additionalProperties": false,
      "description": "One ``/vulnerabilities[]`` item exactly as the vendor states it (an advisory claim, never verified).",
      "properties": {
        "assessment": {
          "const": "advisory-claim",
          "default": "advisory-claim",
          "title": "Assessment",
          "type": "string"
        },
        "contract": {
          "const": "intelligence/1",
          "default": "intelligence/1",
          "title": "Contract",
          "type": "string"
        },
        "cve": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cve"
        },
        "cwe": {
          "anyOf": [
            {
              "$ref": "#/$defs/CweRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "flags": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Flag"
          },
          "title": "Flags",
          "type": "array"
        },
        "ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VulnerabilityId"
          },
          "title": "Ids",
          "type": "array"
        },
        "notes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Note"
          },
          "title": "Notes",
          "type": "array"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "product_status": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StatusClaim"
          },
          "title": "Product Status",
          "type": "array"
        },
        "remediations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Remediation"
          },
          "title": "Remediations",
          "type": "array"
        },
        "scores": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Score"
          },
          "title": "Scores",
          "type": "array"
        },
        "source_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Id",
          "type": "string"
        },
        "threats": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Threat"
          },
          "title": "Threats",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "source_id",
        "pointer"
      ],
      "title": "CVEFact",
      "type": "object"
    },
    "CweRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^CWE-[1-9][0-9]{0,5}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "pointer"
      ],
      "title": "CweRef",
      "type": "object"
    },
    "FileHash": {
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "File Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "file_name",
        "sha256"
      ],
      "title": "FileHash",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One validation result. ``test`` is a CSAF 2.0 section id (``6.1.1``), ``schema``, ``json`` or ``limit``.",
      "properties": {
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "test": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Test",
          "type": "string"
        }
      },
      "required": [
        "test",
        "severity",
        "pointer",
        "message"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Flag": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "group_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Group Ids",
          "type": "array"
        },
        "label": {
          "enum": [
            "component_not_present",
            "inline_mitigations_already_exist",
            "vulnerable_code_cannot_be_controlled_by_adversary",
            "vulnerable_code_not_in_execute_path",
            "vulnerable_code_not_present"
          ],
          "title": "Label",
          "type": "string"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "product_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Product Ids",
          "type": "array"
        },
        "via_groups": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Via Groups",
          "type": "array"
        }
      },
      "required": [
        "pointer",
        "label"
      ],
      "title": "Flag",
      "type": "object"
    },
    "Identification": {
      "additionalProperties": false,
      "properties": {
        "cpe": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpe"
        },
        "purl": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purl"
        },
        "sha256_hashes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FileHash"
          },
          "maxItems": 10000,
          "title": "Sha256 Hashes",
          "type": "array"
        }
      },
      "title": "Identification",
      "type": "object"
    },
    "Note": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience"
        },
        "category": {
          "enum": [
            "description",
            "details",
            "faq",
            "general",
            "legal_disclaimer",
            "other",
            "summary"
          ],
          "title": "Category",
          "type": "string"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "text": {
          "maxLength": 1048576,
          "title": "Text",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "category",
        "text",
        "pointer"
      ],
      "title": "Note",
      "type": "object"
    },
    "Product": {
      "additionalProperties": false,
      "properties": {
        "branch_path": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BranchStep"
          },
          "maxItems": 64,
          "title": "Branch Path",
          "type": "array"
        },
        "definition": {
          "enum": [
            "branch",
            "full_product_name",
            "relationship"
          ],
          "title": "Definition",
          "type": "string"
        },
        "group_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Group Ids",
          "type": "array"
        },
        "identification": {
          "$ref": "#/$defs/Identification",
          "default": {
            "cpe": null,
            "purl": null,
            "sha256_hashes": []
          }
        },
        "name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "product_id": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "relationship": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelationshipRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "version_range": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version Range"
        }
      },
      "required": [
        "product_id",
        "name",
        "definition",
        "pointer"
      ],
      "title": "Product",
      "type": "object"
    },
    "ProductGroup": {
      "additionalProperties": false,
      "properties": {
        "group_id": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Group Id",
          "type": "string"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "product_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Product Ids",
          "type": "array"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        }
      },
      "required": [
        "group_id",
        "product_ids",
        "pointer"
      ],
      "title": "ProductGroup",
      "type": "object"
    },
    "RelationshipRef": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "default_component_of",
            "external_component_of",
            "installed_on",
            "installed_with",
            "optional_component_of"
          ],
          "title": "Category",
          "type": "string"
        },
        "product_reference": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Product Reference",
          "type": "string"
        },
        "relates_to_product_reference": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Relates To Product Reference",
          "type": "string"
        }
      },
      "required": [
        "category",
        "product_reference",
        "relates_to_product_reference"
      ],
      "title": "RelationshipRef",
      "type": "object"
    },
    "Remediation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "mitigation",
            "no_fix_planned",
            "none_available",
            "vendor_fix",
            "workaround"
          ],
          "title": "Category",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "details": {
          "maxLength": 1048576,
          "title": "Details",
          "type": "string"
        },
        "group_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Group Ids",
          "type": "array"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "product_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Product Ids",
          "type": "array"
        },
        "restart_required": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Restart Required"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "via_groups": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Via Groups",
          "type": "array"
        }
      },
      "required": [
        "pointer",
        "category",
        "details"
      ],
      "title": "Remediation",
      "type": "object"
    },
    "Score": {
      "additionalProperties": false,
      "description": "Severity context only (never a vulnerability probability). The score is kept as a decimal string.",
      "properties": {
        "base_score": {
          "pattern": "^(10(\\.0)?|[0-9](\\.[0-9])?)$",
          "title": "Base Score",
          "type": "string"
        },
        "base_severity": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Severity"
        },
        "cvss_version": {
          "enum": [
            "2.0",
            "3.0",
            "3.1"
          ],
          "title": "Cvss Version",
          "type": "string"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "products": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Products",
          "type": "array"
        },
        "vector": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vector"
        }
      },
      "required": [
        "cvss_version",
        "base_score",
        "products",
        "pointer"
      ],
      "title": "Score",
      "type": "object"
    },
    "StatusClaim": {
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "product_id": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Product Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "first_affected",
            "first_fixed",
            "fixed",
            "known_affected",
            "known_not_affected",
            "last_affected",
            "recommended",
            "under_investigation"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "status",
        "pointer"
      ],
      "title": "StatusClaim",
      "type": "object"
    },
    "Threat": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "exploit_status",
            "impact",
            "target_set"
          ],
          "title": "Category",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "details": {
          "maxLength": 1048576,
          "title": "Details",
          "type": "string"
        },
        "group_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Group Ids",
          "type": "array"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "product_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Product Ids",
          "type": "array"
        },
        "via_groups": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Via Groups",
          "type": "array"
        }
      },
      "required": [
        "pointer",
        "category",
        "details"
      ],
      "title": "Threat",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "intelligence/1",
          "default": "intelligence/1",
          "title": "Contract",
          "type": "string"
        },
        "document_category": {
          "maxLength": 1000,
          "title": "Document Category",
          "type": "string"
        },
        "errors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Errors",
          "type": "array"
        },
        "tests_not_implemented": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tests Not Implemented",
          "type": "array"
        },
        "tests_run": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tests Run",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "validator_version": {
          "minimum": 1,
          "title": "Validator Version",
          "type": "integer"
        },
        "warnings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "validator_version",
        "document_category"
      ],
      "title": "ValidationReport",
      "type": "object"
    },
    "VulnerabilityId": {
      "additionalProperties": false,
      "properties": {
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        },
        "system_name": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "System Name",
          "type": "string"
        },
        "text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "system_name",
        "text",
        "pointer"
      ],
      "title": "VulnerabilityId",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/intelligence/1/AdvisoryFacts.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Normalized, content-derived view of one accepted CSAF document (same bytes, same facts).",
  "properties": {
    "contract": {
      "const": "intelligence/1",
      "default": "intelligence/1",
      "title": "Contract",
      "type": "string"
    },
    "current_release_date": {
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Current Release Date",
      "type": "string"
    },
    "document_category": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Document Category",
      "type": "string"
    },
    "document_notes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Note"
      },
      "title": "Document Notes",
      "type": "array"
    },
    "facts_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Facts Id",
      "type": "string"
    },
    "groups": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProductGroup"
      },
