{
  "$id": "https://patchtrace.local/schemas/ir-extract-request/1/ExtractRequest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Request to the extractor child (03 s2); PatchTrace-authored, so text is rejected, never rewritten.\nInvariants: gzf mode needs gzf_path+gzf_sha256 together, analyze takes none, decompile needs a GZF and at least\none sorted unique RVA, analysis_options apply to analyze only, limits are `UnifiedLimits` fields.",
  "properties": {
    "analysis_options": {
      "additionalProperties": {
        "maxLength": 256,
        "minLength": 0,
        "type": "string"
      },
      "propertyNames": {
        "maxLength": 128,
        "minLength": 1
      },
      "title": "Analysis Options",
      "type": "object"
    },
    "artifact_path": {
      "title": "Artifact Path",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "contract": {
      "const": "ir-extract-request/1",
      "default": "ir-extract-request/1",
      "title": "Contract",
      "type": "string"
    },
    "decompile_rvas": {
      "default": [],
      "items": {
        "maximum": 4294967295,
        "minimum": 0,
        "type": "integer"
      },
      "maxItems": 64,
      "title": "Decompile Rvas",
      "type": "array"
    },
    "gzf_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Gzf Path"
    },
    "gzf_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Gzf Sha256"
    },
    "limits": {
      "patternProperties": {
        "^l[0-9]{2}_[a-z0-9_]{1,48}$": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "max_heap_mb": {
      "maximum": 16384,
      "minimum": 512,
      "title": "Max Heap Mb",
      "type": "integer"
    },
    "mode": {
      "enum": [
        "gzf",
        "analyze",
        "decompile"
      ],
      "title": "Mode",
      "type": "string"
    },
    "out_dir": {
      "title": "Out Dir",
      "type": "string"
    },
    "side": {
      "enum": [
        "older",
        "newer"
      ],
      "title": "Side",
      "type": "string"
    },
    "work_dir": {
      "title": "Work Dir",
      "type": "string"
    }
  },
  "required": [
    "side",
    "artifact_path",
    "artifact_sha256",
    "mode",
    "gzf_path",
    "gzf_sha256",
    "out_dir",
    "work_dir",
    "max_heap_mb",
    "analysis_options",
    "limits"
  ],
  "title": "ExtractRequest",
  "type": "object"
}
