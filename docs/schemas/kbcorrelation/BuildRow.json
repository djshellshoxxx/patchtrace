{
  "$id": "https://patchtrace.local/schemas/kbcorrelation/1/BuildRow.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "kbcorrelation/1",
      "default": "kbcorrelation/1",
      "title": "Contract",
      "type": "string"
    },
    "data_date": {
      "anyOf": [
        {
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Date"
    },
    "download": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Download"
    },
    "file_name": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "File Name",
      "type": "string"
    },
    "heading_class": {
      "enum": [
        "standard",
        "preview",
        "out-of-band",
        "expired",
        "none"
      ],
      "title": "Heading Class",
      "type": "string"
    },
    "kb": {
      "anyOf": [
        {
          "pattern": "^KB[0-9]{4,10}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kb"
    },
    "record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "release_date": {
      "anyOf": [
        {
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Date"
    },
    "release_version": {
      "anyOf": [
        {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Version"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "shared_with": {
      "default": [],
      "items": {
        "pattern": "^KB[0-9]{4,10}$",
        "type": "string"
      },
      "title": "Shared With",
      "type": "array"
    },
    "variant": {
      "enum": [
        "full",
        "delta+",
        "delta",
        "raw"
      ],
      "title": "Variant",
      "type": "string"
    },
    "version_key": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Version Key",
      "type": "string"
    }
  },
  "required": [
    "file_name",
    "sha256",
    "version_key",
    "heading_class",
    "variant",
    "record_sha256"
  ],
  "title": "BuildRow",
  "type": "object"
}
