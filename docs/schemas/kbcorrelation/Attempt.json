{
  "$id": "https://patchtrace.local/schemas/kbcorrelation/1/Attempt.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Consent record and recovery journal entry.",
  "properties": {
    "code": {
      "anyOf": [
        {
          "pattern": "^PT-KBC-[A-Z]{3,12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code"
    },
    "contract": {
      "const": "kbcorrelation/1",
      "default": "kbcorrelation/1",
      "title": "Contract",
      "type": "string"
    },
    "created_at": {
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Created At",
      "type": "string"
    },
    "op": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Op",
      "type": "string"
    },
    "plan_sha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Plan Sha"
    },
    "result": {
      "enum": [
        "ok",
        "partial",
        "cancelled",
        "error"
      ],
      "title": "Result",
      "type": "string"
    },
    "stage": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    }
  },
  "required": [
    "op",
    "stage",
    "result",
    "created_at"
  ],
  "title": "Attempt",
  "type": "object"
}
