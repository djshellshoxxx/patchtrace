{
  "$defs": {
    "InventoryClaimRef": {
      "additionalProperties": false,
      "description": "A claim in original CSV bytes; deliberately separate from a JSON Pointer.",
      "properties": {
        "entry_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Entry Id",
          "type": "string"
        },
        "import_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Import Id",
          "type": "string"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "logical_record": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Logical Record",
          "type": "integer"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "section_index": {
          "maximum": 999,
          "minimum": 0,
          "title": "Section Index",
          "type": "integer"
        }
      },
      "required": [
        "import_id",
        "entry_id",
        "raw_sha256",
        "logical_record",
        "line_start",
        "line_end",
        "section_index"
      ],
      "title": "InventoryClaimRef",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "assertion": {
          "enum": [
            "advisory_fact",
            "index_claim",
            "binary_observation",
            "rule_hypothesis",
            "analyst_statement"
          ],
          "title": "Assertion",
          "type": "string"
        },
        "doc_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Doc Id",
          "type": "string"
        },
        "pointer": {
          "maxLength": 4096,
          "pattern": "^(/([^/~]|~[01])*)*$",
          "title": "Pointer",
          "type": "string"
        }
      },
      "required": [
        "doc_id",
        "pointer",
        "assertion"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/kbcorrelation/1/ComponentHint.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "basename": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Basename",
      "type": "string"
    },
    "changed_in_kb": {
      "default": "unknown",
      "enum": [
        "yes",
        "no",
        "unknown"
      ],
      "title": "Changed In Kb",
      "type": "string"
    },
    "claim_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Claim Refs",
      "type": "array"
    },
    "contract": {
      "const": "kbcorrelation/1",
      "default": "kbcorrelation/1",
      "title": "Contract",
      "type": "string"
    },
    "hint_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hint Id",
      "type": "string"
    },
    "inventory_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InventoryClaimRef"
      },
      "title": "Inventory Refs",
      "type": "array"
    },
    "reasons": {
      "default": [],
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Reasons",
      "type": "array"
    },
    "scope_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scope Id",
      "type": "string"
    },
    "tier": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "required": [
    "hint_id",
    "basename",
    "scope_id",
    "tier"
  ],
  "title": "ComponentHint",
  "type": "object"
}
