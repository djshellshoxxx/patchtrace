          "enum": [
            "UNKNOWN_ARCHITECTURE",
            "ARCHITECTURE_CONFLICT",
            "UNKNOWN_VERSION",
            "INVALID_SIZE",
            "INVALID_FILENAME",
            "COLUMN_COUNT",
            "PRODUCT_CONFLICT",
            "RELEASE_CONFLICT",
            "BUILD_CONFLICT",
            "INVALID_METADATA",
            "CONFLICTING_METADATA",
            "UNKNOWN_SECTION",
            "RESULT_LIMIT",
            "RECORD_LIMIT"
          ],
          "title": "Code",
          "type": "string"
        },
        "level": {
          "enum": [
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/CsvRecordRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "message",
        "level"
      ],
      "title": "CsvDiagnostic",
      "type": "object"
    },
