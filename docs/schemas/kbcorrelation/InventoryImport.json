  "$id": "https://patchtrace.local/schemas/kbcorrelation/1/InventoryImport.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asserted_source": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Asserted Source"
    },
    "contract": {
      "const": "kb-inventory-import/1",
      "default": "kb-inventory-import/1",
      "title": "Contract",
      "type": "string"
    },
    "import_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Import Id",
      "type": "string"
    },
    "parsed": {
      "discriminator": {
        "mapping": {
          "kb-file-inventory/1": "#/$defs/CsvInventory",
          "kb-file-inventory/2": "#/$defs/CsvInventoryPage"
        },
        "propertyName": "contract"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CsvInventory"
        },
        {
          "$ref": "#/$defs/CsvInventoryPage"
        }
      ],
      "title": "Parsed"
    },
    "retrieval": {
      "anyOf": [
        {
          "$ref": "#/$defs/RetrievalProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "$ref": "#/$defs/SourceDoc"
    }
  },
  "required": [
    "import_id",
    "source",
    "parsed"
  ],
  "title": "InventoryImport",
  "type": "object"
}
