{
  "$id": "https://patchtrace.local/schemas/kbcorrelation/1/RetrievalProvenance.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The exact bounded fetch receipt; it asserts TLS transport, not authorship.",
  "properties": {
    "final_url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Final Url",
      "type": "string"
    },
    "kind": {
      "enum": [
        "file-inventory",
        "support-page"
      ],
      "title": "Kind",
      "type": "string"
    },
    "original_url": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Original Url",
      "type": "string"
    },
    "plan_sha": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha",
      "type": "string"
    },
    "redirect_chain": {
      "items": {
        "maxLength": 2048,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Redirect Chain",
      "type": "array"
    },
    "retrieved_at": {
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "title": "Retrieved At",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size": {
      "maximum": 16777216,
      "minimum": 0,
      "title": "Size",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "original_url",
    "final_url",
    "redirect_chain",
    "sha256",
    "size",
    "retrieved_at",
    "plan_sha"
  ],
  "title": "RetrievalProvenance",
  "type": "object"
}
