{
  "$id": "https://patchtrace.local/schemas/kbcorrelation/1/InventoryPageLimits.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Source pages retain a smaller population without changing serialized budget fields.",
  "properties": {
    "max_bytes": {
      "default": 16777216,
      "maximum": 16777216,
      "minimum": 1,
      "title": "Max Bytes",
      "type": "integer"
    },
    "max_columns": {
      "default": 32,
      "maximum": 32,
      "minimum": 1,
      "title": "Max Columns",
      "type": "integer"
    },
    "max_diagnostics": {
      "default": 1000,
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Diagnostics",
      "type": "integer"
    },
    "max_entries": {
      "default": 5000,
      "maximum": 5000,
      "minimum": 1,
      "title": "Max Entries",
      "type": "integer"
    },
    "max_field_chars": {
      "default": 65536,
      "maximum": 65536,
      "minimum": 1,
      "title": "Max Field Chars",
      "type": "integer"
    },
    "max_record_chars": {
      "default": 262144,
      "maximum": 262144,
      "minimum": 1,
      "title": "Max Record Chars",
      "type": "integer"
    },
    "max_records": {
      "default": 100000,
      "maximum": 100000,
      "minimum": 1,
      "title": "Max Records",
      "type": "integer"
    },
    "max_seconds": {
      "default": 10.0,
      "exclusiveMinimum": 0,
      "maximum": 10,
      "title": "Max Seconds",
      "type": "number"
    },
    "max_sections": {
      "default": 1000,
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Sections",
      "type": "integer"
    },
    "max_text_chars": {
      "default": 16777216,
      "maximum": 16777216,
      "minimum": 1,
      "title": "Max Text Chars",
      "type": "integer"
    }
  },
  "title": "InventoryPageLimits",
  "type": "object"
}
