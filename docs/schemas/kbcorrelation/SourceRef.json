{
  "$id": "https://patchtrace.local/schemas/kbcorrelation/1/SourceRef.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertion": {
      "enum": [
        "advisory_fact",
        "index_claim",
        "binary_observation",
        "rule_hypothesis",
        "analyst_statement"
      ],
      "title": "Assertion",
      "type": "string"
    },
    "doc_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Doc Id",
      "type": "string"
    },
    "pointer": {
      "maxLength": 4096,
      "pattern": "^(/([^/~]|~[01])*)*$",
      "title": "Pointer",
      "type": "string"
    }
  },
  "required": [
    "doc_id",
    "pointer",
    "assertion"
  ],
  "title": "SourceRef",
  "type": "object"
}
