{
  "$defs": {
    "ApplicabilitySummary": {
      "additionalProperties": false,
      "description": "What the advisory says about the two builds (from the intelligence/1 ApplicabilityReport).",
      "properties": {
        "contradictions": {
          "default": 0,
          "minimum": 0,
          "title": "Contradictions",
          "type": "integer"
        },
        "newer": {
          "enum": [
            "affected",
            "not_affected",
            "fixed",
            "under_investigation",
            "contradictory",
            "ambiguous",
            "unknown"
          ],
          "title": "Newer",
          "type": "string"
        },
        "newer_mapping": {
          "enum": [
            "verified",
            "candidate",
            "unknown"
          ],
          "title": "Newer Mapping",
          "type": "string"
        },
        "older": {
          "enum": [
            "affected",
            "not_affected",
            "fixed",
            "under_investigation",
            "contradictory",
            "ambiguous",
            "unknown"
          ],
          "title": "Older",
          "type": "string"
        },
        "older_mapping": {
          "enum": [
            "verified",
            "candidate",
            "unknown"
          ],
          "title": "Older Mapping",
          "type": "string"
        }
      },
      "required": [
        "older",
        "newer",
        "older_mapping",
        "newer_mapping"
      ],
      "title": "ApplicabilitySummary",
      "type": "object"
    },
    "ChannelStatus": {
      "additionalProperties": false,
      "description": "State of one evidence channel; missing evidence is unknown, never a negative vote.",
      "properties": {
        "channel": {
          "enum": [
            "advisory",
            "code",
            "calls",
            "strings",
            "capa",
            "build",
            "pairing"
          ],
          "title": "Channel",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "available",
            "partial",
            "not-run",
            "unsupported",
            "failed",
            "stale"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "state"
      ],
      "title": "ChannelStatus",
      "type": "object"
    },
    "Confounding": {
      "additionalProperties": false,
      "description": "Whether several CVEs are fixed on the newer build, so that shape alone cannot isolate one of them.",
      "properties": {
        "cves": {
          "default": [],
          "items": {
            "maxLength": 24,
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
            "type": "string"
          },
          "maxItems": 1024,
          "title": "Cves",
          "type": "array"
        },
        "state": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "Confounding",
      "type": "object"
    },
    "CveContext": {
      "additionalProperties": false,
      "description": "Per-CVE context of an assessment: the applicability gate, CWE profile, KEV state, window and lead counts.",
      "properties": {
        "applicability": {
          "$ref": "#/$defs/ApplicabilitySummary"
        },
        "confounding": {
          "$ref": "#/$defs/Confounding"
        },
        "counts": {
          "$ref": "#/$defs/LeadCounts"
        },
        "cve": {
          "maxLength": 24,
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
          "title": "Cve",
          "type": "string"
        },
        "cwe": {
          "$ref": "#/$defs/CweSummary"
        },
        "gate": {
          "enum": [
            "applies",
            "asserted",
            "unverified",
            "conflict",
            "not-applicable"
          ],
          "title": "Gate",
          "type": "string"
        },
        "kev": {
          "$ref": "#/$defs/Kev"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Limitations",
          "type": "array"
        },
        "source_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "cve",
        "gate",
        "applicability",
        "cwe",
        "kev",
        "confounding",
        "counts"
      ],
      "title": "CveContext",
      "type": "object"
    },
    "CweSummary": {
      "additionalProperties": false,
      "properties": {
        "ids": {
          "default": [],
          "items": {
            "pattern": "^CWE-[1-9][0-9]{0,5}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "explicit",
            "derived",
            "weak",
            "vague",
            "none"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "CweSummary",
      "type": "object"
    },
    "ExpectedChange": {
      "additionalProperties": false,
      "description": "One change a weakness rule expects (e.g. a guard added) with its three-valued state.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9-]{1,48}$",
          "title": "Id",
          "type": "string"
        },
        "observation_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Observation Ids",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "met",
            "not-observed",
            "unknown",
            "contradicted"
          ],
          "title": "State",
          "type": "string"
        },
        "teach_id": {
          "pattern": "^pilot\\.[a-z]+\\.[a-z0-9-]{1,48}$",
          "title": "Teach Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "state",
        "required",
        "teach_id"
      ],
      "title": "ExpectedChange",
      "type": "object"
    },
    "FunctionRef": {
      "additionalProperties": false,
      "description": "One function of a candidate side: module-relative address and display name (untrusted, sanitised).",
      "properties": {
        "name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "rva": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Rva",
          "type": "integer"
        }
      },
      "required": [
        "rva"
      ],
      "title": "FunctionRef",
      "type": "object"
    },
    "HypothesisFit": {
      "additionalProperties": false,
      "description": "How one weakness hypothesis (K rule id and revision) fits a candidate.",
      "properties": {
        "basis": {
          "enum": [
            "explicit-csaf-cwe",
            "cwe-id-in-text",
            "curated-vocabulary"
          ],
          "title": "Basis",
          "type": "string"
        },
        "cwe_id": {
          "pattern": "^CWE-[1-9][0-9]{0,5}$",
          "title": "Cwe Id",
          "type": "string"
        },
        "expected_changes": {
          "items": {
            "$ref": "#/$defs/ExpectedChange"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Expected Changes",
          "type": "array"
        },
        "hypothesis_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "met": {
          "minimum": 0,
          "title": "Met",
          "type": "integer"
        },
        "rule_id": {
          "pattern": "^R-[A-Z0-9-]{1,40}$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_revision": {
          "minimum": 1,
          "title": "Rule Revision",
          "type": "integer"
        },
        "total": {
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "hypothesis_id",
        "rule_id",
        "rule_revision",
        "cwe_id",
        "basis",
        "expected_changes",
        "met",
        "total"
      ],
      "title": "HypothesisFit",
      "type": "object"
    },
    "Kev": {
      "additionalProperties": false,
      "description": "CISA KEV context for a CVE: ordering of CVEs only, never evidence about a function. Absence says nothing.",
      "properties": {
        "date_added": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date Added"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "state": {
          "enum": [
            "listed",
            "not-in-snapshot",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "Kev",
      "type": "object"
    },
    "Lead": {
      "additionalProperties": false,
      "description": "One candidate function pair assessed in one context (a CVE, or `cve` null for code evidence only).\n\n`rank` is the display position within the context; `fits` lists every hypothesis, best first. The four id lists\nreference the assessment's observation pool: `support_ids` back the listing, `counter_ids` hold counter and\nconflict evidence, `unknown_ids` record evidence that could not be assessed, `alternative_ids` favour another\nexplanation (for example a toolchain change).",
      "properties": {
        "alternative_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Alternative Ids",
          "type": "array"
        },
        "assessment": {
          "enum": [
            "rule-hypothesis",
            "unknown"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "candidate_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Key",
          "type": "string"
        },
        "caps": {
          "default": [],
          "items": {
            "enum": [
              "confounded-window-needs-locality",
              "toolchain-changed-lexical-only",
              "cve-unverified",
              "cve-conflict"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Caps",
          "type": "array"
        },
        "components": {
          "$ref": "#/$defs/LeadComponents"
        },
        "counter_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Counter Ids",
          "type": "array"
        },
        "cve": {
          "anyOf": [
            {
              "maxLength": 24,
              "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cve"
        },
        "depth": {
          "enum": [
            "typed",
            "lexical",
            "none"
          ],
          "title": "Depth",
          "type": "string"
        },
        "fits": {
          "default": [],
          "items": {
            "$ref": "#/$defs/HypothesisFit"
          },
          "maxItems": 64,
          "title": "Fits",
          "type": "array"
        },
        "gate": {
          "enum": [
            "applies",
            "asserted",
            "unverified",
            "conflict",
            "none"
          ],
          "title": "Gate",
          "type": "string"
        },
        "identity": {
          "enum": [
            "corroborated",
            "contested",
            "unassessed"
          ],
          "title": "Identity",
          "type": "string"
        },
        "lead_class": {
          "enum": [
            "fit",
            "review",
            "partial",
            "code",
            "queue"
          ],
          "title": "Lead Class",
          "type": "string"
        },
        "local_hits": {
          "default": 0,
          "minimum": 0,
          "title": "Local Hits",
          "type": "integer"
        },
        "mechanism": {
          "enum": [
            "moderate",
            "tentative",
            "unexplained",
            "contested",
            "not-assessed"
          ],
          "title": "Mechanism",
          "type": "string"
        },
        "newer": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FunctionRef"
          },
          "maxItems": 256,
          "title": "Newer",
          "type": "array"
        },
        "older": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FunctionRef"
          },
          "maxItems": 256,
          "title": "Older",
          "type": "array"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "support_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Support Ids",
          "type": "array"
        },
        "tie": {
          "$ref": "#/$defs/Tie"
        },
        "unknown_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Unknown Ids",
          "type": "array"
        }
      },
      "required": [
        "candidate_key",
        "lead_class",
        "mechanism",
        "identity",
        "gate",
        "depth",
        "components",
        "rank",
        "tie",
        "assessment"
      ],
      "title": "Lead",
      "type": "object"
    },
    "LeadComponents": {
      "additionalProperties": false,
      "description": "Independent origin components behind a lead: `tags` holds the smallest origin tag of each component.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "tags": {
          "default": [],
          "items": {
            "pattern": "^D_[a-z0-9_]{1,32}$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "count"
      ],
      "title": "LeadComponents",
      "type": "object"
    },
    "LeadCounts": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minimum": 0,
          "title": "Code",
          "type": "integer"
        },
        "fit": {
          "minimum": 0,
          "title": "Fit",
          "type": "integer"
        },
        "partial": {
          "minimum": 0,
          "title": "Partial",
          "type": "integer"
        },
        "queue": {
          "minimum": 0,
          "title": "Queue",
          "type": "integer"
        },
        "review": {
          "minimum": 0,
          "title": "Review",
          "type": "integer"
        }
      },
      "required": [
        "fit",
        "review",
        "partial",
        "code",
        "queue"
      ],
      "title": "LeadCounts",
      "type": "object"
    },
    "Nav": {
      "additionalProperties": false,
      "description": "Where to look: a side, a module-relative address and optional 1-based inclusive lines.",
      "properties": {
        "end_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Line"
        },
        "rva": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Rva",
          "type": "integer"
        },
        "side": {
          "enum": [
            "older",
            "newer"
          ],
          "title": "Side",
          "type": "string"
        },
        "start_line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Line"
        }
      },
      "required": [
        "side",
        "rva"
      ],
      "title": "Nav",
      "type": "object"
    },
    "ObsRef": {
      "additionalProperties": false,
      "description": "What the observation was read from: a source kind and id, an optional RFC 6901 pointer and content digest.",
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9-]{1,48}$",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "anyOf": [
            {
              "maxLength": 4096,
              "pattern": "^(/([^/~]|~[01])*)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "ObsRef",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "One flat ledger entry; `obs_id` is the content id (keys.observation_id), so duplicates collapse.",
      "properties": {
        "anchor_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_-]{0,15}:[\\x21-\\x7e]{1,200}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Anchor Ids",
          "type": "array"
        },
        "channel": {
          "enum": [
            "advisory",
            "code",
            "calls",
            "strings",
            "capa",
            "build",
            "pairing"
          ],
          "title": "Channel",
          "type": "string"
        },
        "detail": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "evidence_class": {
          "pattern": "^E-[A-Z][A-Z0-9]{1,11}$",
          "title": "Evidence Class",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z][a-z0-9]{0,11}:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
          "title": "Kind",
          "type": "string"
        },
        "nav": {
          "anyOf": [
            {
              "$ref": "#/$defs/Nav"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "obligations": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9-]{1,48}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Obligations",
          "type": "array"
        },
        "obs_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Obs Id",
          "type": "string"
        },
        "origins": {
          "items": {
            "pattern": "^D_[a-z0-9_]{1,32}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Origins",
          "type": "array"
        },
        "ref": {
          "$ref": "#/$defs/ObsRef"
        },
        "role": {
          "enum": [
            "shape",
            "local",
            "counter",
            "conflict",
            "context"
          ],
          "title": "Role",
          "type": "string"
        },
        "verification": {
          "enum": [
            "verified-bytes",
            "tool-reported",
            "label-only",
            "advisory-claim",
            "rule-hypothesis",
            "analyst-assertion"
          ],
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "obs_id",
        "channel",
        "kind",
        "role",
        "verification",
        "origins",
        "evidence_class",
        "ref",
        "detail"
      ],
      "title": "Observation",
      "type": "object"
    },
    "PilotInputs": {
      "additionalProperties": false,
      "description": "The `result_id` payload (s7), stored verbatim so the UI can name a changed input. Reviews, timestamps and\npaths are never part of it.",
      "properties": {
        "advisory_facts_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Advisory Facts Ids",
          "type": "array"
        },
        "asserted_gates": {
          "default": [],
          "items": {
            "maxLength": 24,
            "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Asserted Gates",
          "type": "array"
        },
        "config_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "ghidriff_run_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Ghidriff Run Id",
          "type": "string"
        },
        "kb_link_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kb Link Digest"
        },
        "kev_snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kev Snapshot Id"
        },
        "lexicon_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lexicon Digest",
          "type": "string"
        },
        "newer_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Newer Sha256",
          "type": "string"
        },
        "older_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Older Sha256",
          "type": "string"
        },
        "orientation": {
          "const": "older->newer",
          "default": "older->newer",
          "title": "Orientation",
          "type": "string"
        },
        "origins_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Origins Digest",
          "type": "string"
        },
        "pilot_rules_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pilot Rules Digest",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "rules_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rules Digest",
          "type": "string"
        },
        "secondary_set_ids": {
          "default": [],
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Secondary Set Ids",
          "type": "array"
        },
        "tiers_version": {
          "minimum": 1,
          "title": "Tiers Version",
          "type": "integer"
        },
        "tool_keys": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolKey"
          },
          "maxItems": 6,
          "title": "Tool Keys",
          "type": "array"
        },
        "unified_result_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unified Result Id"
        }
      },
      "required": [
        "older_sha256",
        "newer_sha256",
        "ghidriff_run_id",
        "raw_sha256",
        "lexicon_digest",
        "rules_digest",
        "pilot_rules_digest",
        "origins_digest",
        "tiers_version",
        "config_digest"
      ],
      "title": "PilotInputs",
      "type": "object"
    },
    "Tie": {
      "additionalProperties": false,
      "description": "Leads with equal evidence share a tie group: positions `first`..`last`, shown as \"n-m (tie)\".",
      "properties": {
        "first": {
          "minimum": 1,
          "title": "First",
          "type": "integer"
        },
        "last": {
          "minimum": 1,
          "title": "Last",
          "type": "integer"
        },
        "size": {
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "size",
        "first",
        "last"
      ],
      "title": "Tie",
      "type": "object"
    },
    "ToolKey": {
      "additionalProperties": false,
      "description": "The cache key of one tool result (intelligence/tools ToolRun.cache_key) for one side.",
      "properties": {
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "engine": {
          "enum": [
            "capa",
            "floss",
            "diec"
          ],
          "title": "Engine",
          "type": "string"
        },
        "side": {
          "enum": [
            "older",
            "newer"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "side",
        "cache_key"
      ],
      "title": "ToolKey",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/pilot/1/PilotAssessment.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The persisted result of one localization run (sidecar `assessment.json.gz`), derived and never edited.",
  "properties": {
    "channels": {
      "items": {
        "$ref": "#/$defs/ChannelStatus"
      },
      "maxItems": 7,
      "title": "Channels",
      "type": "array"
    },
    "contract": {
      "const": "pilot/1",
      "default": "pilot/1",
      "title": "Contract",
      "type": "string"
    },
    "created_utc": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(\\+00:00|Z)$",
      "title": "Created Utc",
      "type": "string"
    },
    "cves": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CveContext"
      },
      "maxItems": 64,
      "title": "Cves",
      "type": "array"
    },
    "inputs": {
      "$ref": "#/$defs/PilotInputs"
    },
    "leads": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Lead"
      },
      "maxItems": 45500,
      "title": "Leads",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "title": "Limitations",
      "type": "array"
    },
    "limits_hit": {
      "default": [],
      "items": {
        "pattern": "^[a-z0-9-]{1,48}$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Limits Hit",
      "type": "array"
    },
    "newer_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Newer Sha256",
      "type": "string"
    },
    "observations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "maxItems": 11648000,
      "title": "Observations",
      "type": "array"
    },
    "older_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Older Sha256",
      "type": "string"
    },
    "orientation": {
      "const": "older->newer",
      "default": "older->newer",
      "title": "Orientation",
      "type": "string"
    },
    "project_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "queue_count": {
      "default": 0,
      "minimum": 0,
      "title": "Queue Count",
      "type": "integer"
    },
    "result_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Result Id",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "abstained"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "result_id",
    "project_id",
    "revision",
    "older_sha256",
    "newer_sha256",
    "inputs",
    "channels",
    "status",
    "created_utc"
  ],
  "title": "PilotAssessment",
  "type": "object"
}
