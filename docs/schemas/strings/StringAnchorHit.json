{
  "$defs": {
    "FunctionRef": {
      "additionalProperties": false,
      "properties": {
        "ambiguous": {
          "default": false,
          "title": "Ambiguous",
          "type": "boolean"
        },
        "match_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Id"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "project_function_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Function Id"
        },
        "rva": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rva"
        },
        "side": {
          "enum": [
            "older",
            "newer"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "side"
      ],
      "title": "FunctionRef",
      "type": "object"
    },
    "StringLink": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        },
        "function": {
          "$ref": "#/$defs/FunctionRef"
        },
        "join": {
          "anyOf": [
            {
              "enum": [
                "exact",
                "contains"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Join"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "lineage_group": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Lineage Group",
          "type": "string"
        },
        "pair_status": {
          "enum": [
            "added",
            "removed",
            "modified",
            "unchanged",
            "ambiguous",
            "unknown"
          ],
          "title": "Pair Status",
          "type": "string"
        },
        "tier": {
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4",
            "L5",
            "L6"
          ],
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "tier",
        "function",
        "pair_status",
        "lineage_group",
        "evidence_ref"
      ],
      "title": "StringLink",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/strings/1/StringAnchorHit.json",
  "additionalProperties": false,
  "properties": {
    "anchor_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Anchor Id",
      "type": "string"
    },
    "contract": {
      "const": "strings-anchor-hit/1",
      "default": "strings-anchor-hit/1",
      "title": "Contract",
      "type": "string"
    },
    "kind": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "lineage_group": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Lineage Group",
      "type": "string"
    },
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StringLink"
      },
      "maxItems": 8,
      "title": "Links",
      "type": "array"
    },
    "match": {
      "enum": [
        "exact",
        "casefold",
        "substring",
        "import-equal"
      ],
      "title": "Match",
      "type": "string"
    },
    "presence_newer": {
      "title": "Presence Newer",
      "type": "boolean"
    },
    "presence_older": {
      "title": "Presence Older",
      "type": "boolean"
    },
    "strength": {
      "const": "anchor",
      "default": "anchor",
      "title": "Strength",
      "type": "string"
    },
    "string_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "String Id",
      "type": "string"
    }
  },
  "required": [
    "anchor_id",
    "kind",
    "match",
    "string_id",
    "presence_older",
    "presence_newer",
    "lineage_group"
  ],
  "title": "StringAnchorHit",
  "type": "object"
}
