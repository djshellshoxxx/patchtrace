          "title": "Older",
          "type": "array"
        },
        "newer": {
          "items": {
            "$ref": "#/$defs/FunctionRecord"
          },
          "title": "Newer",
          "type": "array"
        },
        "category": {
          "enum": [
            "modified",
            "added",
            "removed",
            "unmatched",
            "ambiguous",
            "split",
            "merged",
            "unchanged"
          ],
          "title": "Category",
          "type": "string"
        },
        "match_types": {
          "items": {
            "type": "string"
          },
          "title": "Match Types",
          "type": "array"
        },
        "quality": {
          "default": "unknown",
          "title": "Quality",
          "type": "string"
        },
        "manual": {
          "default": false,
          "title": "Manual",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "review": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "accepted",
            "rejected",
            "needs-review"
          ],
          "title": "Review",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "category"
      ],
      "title": "FunctionMatch",
      "type": "object"
