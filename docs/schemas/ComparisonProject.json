{
  "$defs": {
    "AnalysisContext": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "match_ids": {
          "items": {
            "type": "string"
          },
          "title": "Match Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "title": "Evidence",
          "type": "array"
        },
        "omitted": {
          "items": {
            "type": "string"
          },
          "title": "Omitted",
          "type": "array"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "token_estimate": {
          "minimum": 0,
          "title": "Token Estimate",
          "type": "integer"
        },
        "payload": {
          "title": "Payload",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "project_id",
        "revision",
        "match_ids",
        "evidence",
        "digest",
        "token_estimate",
        "payload"
      ],
      "title": "AnalysisContext",
      "type": "object"
    },
    "AnalysisRun": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "created": {
          "title": "Created",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled",
            "identical"
          ],
          "title": "Status",
          "type": "string"
        },
        "backend": {
          "default": "ghidriff",
          "title": "Backend",
          "type": "string"
        },
        "backend_version": {
          "default": "unknown",
          "title": "Backend Version",
          "type": "string"
        },
        "settings": {
          "additionalProperties": true,
          "title": "Settings",
          "type": "object"
        },
        "raw_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Path"
        },
        "raw_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Sha256"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "status"
      ],
      "title": "AnalysisRun",
      "type": "object"
    },
    "AnalystAnnotation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "note",
            "bookmark",
            "match-override",
            "validation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "created": {
          "title": "Created",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "target_id",
        "kind",
        "text"
      ],
      "title": "AnalystAnnotation",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "side": {
          "enum": [
            "older",
            "newer"
          ],
          "title": "Side",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size": {
          "maximum": 1073741824,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "architecture": {
          "const": "x86-64",
          "default": "x86-64",
          "title": "Architecture",
          "type": "string"
        },
        "format": {
          "const": "PE",
          "default": "PE",
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "side",
        "name",
        "sha256",
        "size",
        "relative_path"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "function_id": {
          "title": "Function Id",
          "type": "string"
        },
        "side": {
          "enum": [
            "older",
            "newer"
          ],
          "title": "Side",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "run_id",
        "function_id",
        "side",
        "start_line",
        "end_line",
        "text"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "context_id": {
          "title": "Context Id",
          "type": "string"
        },
        "match_ids": {
          "items": {
            "type": "string"
          },
          "title": "Match Ids",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "fix_purpose": {
          "title": "Fix Purpose",
          "type": "string"
        },
        "category": {
          "enum": [
            "security-fix",
            "ordinary-bug",
            "feature",
            "refactor",
            "compiler-noise",
            "unknown"
          ],
          "title": "Category",
          "type": "string"
        },
        "hypothesis": {
          "$ref": "#/$defs/Hypothesis"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "cwe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwe"
        },
        "cwe_rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwe Rationale"
        },
        "review": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "accepted",
            "rejected",
            "needs-review"
          ],
          "title": "Review",
          "type": "string"
        },
        "analyst_conclusion": {
          "default": "",
          "title": "Analyst Conclusion",
          "type": "string"
        },
        "stale": {
          "default": false,
          "title": "Stale",
          "type": "boolean"
        }
      },
      "required": [
        "context_id",
        "match_ids",
        "summary",
        "fix_purpose",
        "category",
        "hypothesis"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FunctionMatch": {
      "additionalProperties": false,
