{
  "$id": "https://patchtrace.local/schemas/rules/1/RuleDecision.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The analyst's action on a candidate. Accepting needs a label and saves a version; it publishes nothing.",
  "properties": {
    "action": {
      "enum": [
        "accept",
        "reject",
        "defer",
        "archive"
      ],
      "title": "Action",
      "type": "string"
    },
    "analyst_label": {
      "anyOf": [
        {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analyst Label"
    },
    "candidate_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "contract": {
      "const": "yara-rules/1",
      "default": "yara-rules/1",
      "title": "Contract",
      "type": "string"
    },
    "cve": {
      "default": [],
      "items": {
        "maxLength": 24,
        "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Cve",
      "type": "array"
    },
    "cwe": {
      "default": [],
      "items": {
        "pattern": "^CWE-[1-9][0-9]{0,5}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Cwe",
      "type": "array"
    },
    "decided_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(\\+00:00|Z)$",
      "title": "Decided At",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decision Id",
      "type": "string"
    },
    "kb": {
      "default": [],
      "items": {
        "pattern": "^KB[0-9]{4,10}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Kb",
      "type": "array"
    },
    "note": {
      "default": "",
      "maxLength": 2000,
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "candidate_id",
    "action",
    "decided_at"
  ],
  "title": "RuleDecision",
  "type": "object"
}
