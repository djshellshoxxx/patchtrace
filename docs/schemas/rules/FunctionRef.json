{
  "$id": "https://patchtrace.local/schemas/rules/1/FunctionRef.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One side's function. ``size`` is known only with a verified extent (``.pdata`` or the unified IR); a leaf function\nwithout exception data has ``extent == 'unknown'`` and no size, so no bytes feature can be built from it.",
  "properties": {
    "extent": {
      "enum": [
        "pdata",
        "unified-ir",
        "unknown"
      ],
      "title": "Extent",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "rva": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Rva",
      "type": "integer"
    },
    "size": {
      "anyOf": [
        {
          "exclusiveMaximum": 4294967296,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size"
    }
  },
  "required": [
    "rva",
    "extent"
  ],
  "title": "FunctionRef",
  "type": "object"
}
