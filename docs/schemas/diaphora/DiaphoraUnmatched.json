      "type": "string"
    },
    "ea": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Ea",
      "type": "integer"
    },
    "ea_text": {
      "maxLength": 4096,
      "title": "Ea Text",
      "type": "string"
    },
    "index": {
      "minimum": 0,
      "title": "Index",
      "type": "integer"
    },
    "name": {
      "maxLength": 4096,
      "title": "Name",
      "type": "string"
    },
    "rva": {
      "anyOf": [
