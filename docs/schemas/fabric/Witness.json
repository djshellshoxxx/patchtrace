{
  "$defs": {
    "Ref": {
      "additionalProperties": false,
      "description": "What a witness was read from: a source kind and id, an optional RFC 6901 pointer and content digest.",
      "properties": {
        "id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-z0-9-]{1,48}$",
          "title": "Kind",
          "type": "string"
        },
        "pointer": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pointer"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Ref",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/fabric/1/Witness.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One producer's statement of an anchor, with its provenance. `witness_id` is the content id (`ids.witness_id`),\nso an identical republish collapses; `origins` must equal the registry's tags of `source` (`PT-FAB-ORIGIN`).",
  "properties": {
    "batch": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Batch",
      "type": "string"
    },
    "facets": {
      "default": [],
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "type": "string"
          },
          {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          }
        ],
        "type": "array"
      },
      "maxItems": 16,
      "title": "Facets",
      "type": "array"
    },
    "input_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Sha256"
    },
    "label": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "origins": {
      "items": {
        "pattern": "^D_[a-z0-9_]{1,32}$",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Origins",
      "type": "array"
    },
    "producer": {
      "enum": [
        "core",
        "ue",
        "cap",
        "die",
        "wb3",
        "wbq",
        "wb2",
        "wb1",
        "yrx",
        "kb",
        "kev",
        "pil",
        "analyst"
      ],
      "title": "Producer",
      "type": "string"
    },
    "ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Ref"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "pattern": "^[a-z0-9-]{1,48}$",
      "title": "Source",
      "type": "string"
    },
    "tool": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool"
    },
    "tool_version": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Version"
    },
    "witness_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Witness Id",
      "type": "string"
    }
  },
  "required": [
    "witness_id",
    "producer",
    "batch",
    "source",
    "origins",
    "label"
  ],
  "title": "Witness",
  "type": "object"
}
