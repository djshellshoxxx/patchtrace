{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "created": {
      "title": "Created",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled",
        "identical"
      ],
      "title": "Status",
      "type": "string"
    },
    "backend": {
      "default": "ghidriff",
      "title": "Backend",
      "type": "string"
    },
    "backend_version": {
      "default": "unknown",
      "title": "Backend Version",
      "type": "string"
    },
    "settings": {
      "additionalProperties": true,
      "title": "Settings",
      "type": "object"
    },
    "raw_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Path"
    },
    "raw_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Sha256"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "status"
  ],
  "title": "AnalysisRun",
  "type": "object",
  "$id": "https://patchtrace.local/schemas/v1/AnalysisRun.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
