{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "integer"
    },
    "format": {
      "enum": [
        "json",
        "html",
        "md"
      ],
      "title": "Format",
      "type": "string"
    },
    "sha256": {
      "title": "Sha256",
      "type": "string"
    },
    "finding_ids": {
      "items": {
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    },
    "include_code": {
      "title": "Include Code",
      "type": "boolean"
    },
    "include_notes": {
      "title": "Include Notes",
      "type": "boolean"
    },
    "created": {
      "title": "Created",
      "type": "string"
    },
    "report_version": {
      "default": 1,
      "enum": [
        1,
        2
      ],
      "title": "Report Version",
      "type": "integer"
    },
    "content_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Digest"
    },
    "sections": {
      "items": {
        "type": "string"
      },
      "title": "Sections",
      "type": "array"
    },
    "redaction_profile": {
      "default": "local",
      "title": "Redaction Profile",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "revision",
    "format",
    "sha256",
    "finding_ids",
    "include_code",
    "include_notes"
  ],
  "title": "ExportManifest",
  "type": "object",
  "$id": "https://patchtrace.local/schemas/v1/ExportManifest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
