        "new_presence": {
          "type": "boolean"
        },
        "ignored_unsupported": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "algorithm_version",
        "config_digest",
        "input_digests",
        "created_utc",
        "status",
        "warnings",
        "provenance",
        "signal_id",
        "detector_id",
        "detector_version",
        "pairing_id",
        "category",
        "change_group_id",
        "base_weight",
        "evidence_quality",
        "confidence_tier",
        "refs",
        "explanation",
        "old_presence",
        "new_presence",
