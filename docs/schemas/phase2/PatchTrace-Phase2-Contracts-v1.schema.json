{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patchtrace.local/schemas/phase2/contracts-v1.schema.json",
  "title": "PatchTrace proposed Phase 2 contracts (specification only)",
  "$comment": "No application implementation. Additional semantic validators check exact score arithmetic, identity hashes, run/side ownership, signal/evidence linkage, context provenance, trusted paths, and atomic store invariants.",
  "oneOf": [
    {
      "$ref": "#/$defs/EvidenceRefV1"
    },
    {
      "$ref": "#/$defs/FeatureGateV1"
    },
    {
      "$ref": "#/$defs/ChangeSignalV1"
    },
    {
      "$ref": "#/$defs/RankingConfigV1"
    },
    {
      "$ref": "#/$defs/FunctionRankingV1"
    },
    {
      "$ref": "#/$defs/CVEContextV1"
    },
    {
      "$ref": "#/$defs/ContextualRankingV1"
    },
    {
      "$ref": "#/$defs/CacheManifestV1"
    },
    {
      "$ref": "#/$defs/PipelineExecutionV1"
    }
  ],
  "$defs": {
    "EvidenceRefV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diff_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "side": {
          "type": "string",
          "enum": [
            "older",
            "newer"
          ]
        },
        "occurrence_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "decompile",
            "assembly",
            "pcode",
            "call",
            "symbol",
            "raw-json"
          ]
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "address_kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "va",
                "rva",
                "file",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "address_hex": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "^0x[0-9a-fA-F]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "excerpt_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "verified-structure",
            "derived-structure",
            "text-heuristic",
            "unavailable"
          ]
        }
      },
      "required": [
        "schema_version",
        "id",
        "diff_id",
        "project_id",
        "run_id",
        "artifact_sha256",
        "side",
        "occurrence_id",
        "source_kind",
        "raw_sha256",
        "json_pointer",
        "line_start",
        "line_end",
        "address_kind",
        "address_hex",
        "excerpt_sha256",
        "quality"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "line_start": {
                "type": "integer"
              }
            },
            "required": [
              "line_start"
            ]
          },
          "then": {
            "properties": {
              "line_end": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "line_end": {
                "type": "integer"
              }
            },
            "required": [
              "line_end"
            ]
          },
          "then": {
            "properties": {
              "line_start": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "FeatureGateV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "algorithm_version": {
          "type": "string",
          "minLength": 1
        },
        "config_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_digests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 0
        },
        "created_utc": {
          "type": "string",
          "minLength": 10
        },
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "cancelled",
            "failed"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "feature_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "feature_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "original_symbol": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "original_artifact_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resolution_source": {
          "type": "string",
          "enum": [
            "embedded-symbol",
            "public-PDB",
            "private-PDB",
            "analyst-import",
            "heuristic",
            "unavailable"
          ]
        },
        "resolved_symbol_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "old_sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRefV1"
          },
          "minItems": 0
        },
        "new_sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRefV1"
          },
          "minItems": 0
        },
        "gated_pairings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 0
        },
        "condition_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRefV1"
          },
          "minItems": 0
        },
        "control_relation": {
          "type": "string",
          "enum": [
            "proven-cfg",
            "heuristic-lexical",
            "adjacent-only",
            "unavailable"
          ]
        },
        "transition": {
          "type": "string",
          "enum": [
            "introduced",
            "removed",
            "condition-changed",
            "guarded-behavior-changed",
            "unchanged-around-change",
            "unknown"
          ]
        },
        "confidence_tier": {
          "type": "string",
          "enum": [
            "strong",
            "moderate",
            "weak",
            "unavailable"
          ]
        },
        "nested_parent_feature_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "minItems": 0
        },
        "detector_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "algorithm_version",
        "config_digest",
        "input_digests",
        "created_utc",
        "status",
        "warnings",
        "provenance",
        "feature_id",
        "feature_name",
        "original_symbol",
        "original_artifact_hash",
        "resolution_source",
        "resolved_symbol_hash",
        "old_sites",
        "new_sites",
        "gated_pairings",
        "condition_evidence",
        "control_relation",
        "transition",
        "confidence_tier",
        "nested_parent_feature_ids",
        "detector_version"
      ]
    },
