{
  "$defs": {
    "KevHeaders": {
      "additionalProperties": false,
      "properties": {
        "accept": {
          "const": "application/json",
          "default": "application/json",
          "title": "Accept",
          "type": "string"
        },
        "user_agent": {
          "const": "PatchTrace",
          "default": "PatchTrace",
          "title": "User Agent",
          "type": "string"
        }
      },
      "title": "KevHeaders",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/kev/1/KevPlan.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The exact request shown before consent. Building it does no network and no DNS.",
  "properties": {
    "contract": {
      "const": "kev/1",
      "default": "kev/1",
      "title": "Contract",
      "type": "string"
    },
    "expected_bytes_hint": {
      "default": 1800000,
      "minimum": 0,
      "title": "Expected Bytes Hint",
      "type": "integer"
    },
    "headers": {
      "$ref": "#/$defs/KevHeaders",
      "default": {
        "accept": "application/json",
        "user_agent": "PatchTrace"
      }
    },
    "host": {
      "maxLength": 253,
      "title": "Host",
      "type": "string"
    },
    "max_bytes": {
      "const": 16777216,
      "default": 16777216,
      "title": "Max Bytes",
      "type": "integer"
    },
    "method": {
      "const": "GET",
      "default": "GET",
      "title": "Method",
      "type": "string"
    },
    "operation": {
      "const": "fetch-kev-catalog",
      "default": "fetch-kev-catalog",
      "title": "Operation",
      "type": "string"
    },
    "plan_sha": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha",
      "type": "string"
    },
    "source": {
      "enum": [
        "cisa-site",
        "cisa-github"
      ],
      "title": "Source",
      "type": "string"
    },
    "url": {
      "maxLength": 2048,
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "source",
    "url",
    "host",
    "plan_sha"
  ],
  "title": "KevPlan",
  "type": "object"
}
