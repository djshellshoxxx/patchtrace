{
  "$defs": {
    "KevContextLookup": {
      "additionalProperties": false,
      "properties": {
        "age_days": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Days"
        },
        "contract": {
          "const": "kev/1",
          "default": "kev/1",
          "title": "Contract",
          "type": "string"
        },
        "cve_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Cve Id",
          "type": "string"
        },
        "entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/KevEntrySlim"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "freshness": {
          "enum": [
            "fresh",
            "aging",
            "stale",
            "future",
            "unknown"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "notes": {
          "default": [],
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Notes",
          "type": "array"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Id"
        },
        "status": {
          "enum": [
            "listed",
            "not-listed",
            "unavailable",
            "invalid-id"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "cve_id",
        "status",
        "freshness"
      ],
      "title": "KevContextLookup",
      "type": "object"
    },
    "KevEntrySlim": {
      "additionalProperties": false,
      "description": "An entry without the three long texts: what project rows keep.",
      "properties": {
        "contract": {
          "const": "kev/1",
          "default": "kev/1",
          "title": "Contract",
          "type": "string"
        },
        "cve_id": {
          "maxLength": 24,
          "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
          "title": "Cve Id",
          "type": "string"
        },
        "cwes": {
          "items": {
            "pattern": "^CWE-[0-9]{1,6}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Cwes",
          "type": "array"
        },
        "date_added": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Date Added",
          "type": "string"
        },
        "due_date": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "title": "Due Date",
          "type": "string"
        },
        "entry_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Entry Digest",
          "type": "string"
        },
        "forensic_triage": {
          "enum": [
            "yes",
            "no",
            "absent",
            "unrecognized"
          ],
          "title": "Forensic Triage",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "title": "Name",
          "type": "string"
        },
        "product": {
          "maxLength": 256,
          "title": "Product",
          "type": "string"
        },
        "ransomware_use": {
          "enum": [
            "known",
            "unknown",
            "absent",
            "unrecognized"
          ],
          "title": "Ransomware Use",
          "type": "string"
        },
        "vendor_project": {
          "maxLength": 128,
          "title": "Vendor Project",
          "type": "string"
        }
      },
      "required": [
        "cve_id",
        "vendor_project",
        "product",
        "name",
        "date_added",
        "due_date",
        "cwes",
        "ransomware_use",
        "forensic_triage",
        "entry_digest"
      ],
      "title": "KevEntrySlim",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/kev/1/KevContext.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The project-attached ``kev-context`` row. Wall-clock time is never an input to its identity.",
  "properties": {
    "catalog_version": {
      "maxLength": 32,
      "minLength": 1,
      "title": "Catalog Version",
      "type": "string"
    },
    "content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "context_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Id",
      "type": "string"
    },
    "contract": {
      "const": "kev/1",
      "default": "kev/1",
      "title": "Contract",
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Created At",
      "type": "string"
    },
    "date_released": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Date Released",
      "type": "string"
    },
    "join_version": {
      "const": 1,
      "default": 1,
      "title": "Join Version",
      "type": "integer"
    },
    "kb": {
      "anyOf": [
        {
          "pattern": "^KB[0-9]{6,8}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Kb"
    },
    "lookups": {
      "items": {
        "$ref": "#/$defs/KevContextLookup"
      },
      "maxItems": 256,
      "title": "Lookups",
      "type": "array"
    },
    "orientation_verified": {
      "default": false,
      "title": "Orientation Verified",
      "type": "boolean"
    },
    "release_date": {
      "anyOf": [
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Date"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "cisa-site",
        "cisa-github",
        "local-import"
      ],
      "title": "Source",
      "type": "string"
    }
  },
  "required": [
    "context_id",
    "created_at",
    "snapshot_id",
    "catalog_version",
    "date_released",
    "content_digest",
    "source",
    "lookups"
  ],
  "title": "KevContext",
  "type": "object"
}
