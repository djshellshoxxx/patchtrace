{
  "$defs": {
    "ConsentRecord": {
      "additionalProperties": false,
      "description": "The one consent behind one fetch: nothing is remembered for later requests.",
      "properties": {
        "granted_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Granted At",
          "type": "string"
        },
        "operation": {
          "const": "fetch-kev-catalog",
          "title": "Operation",
          "type": "string"
        },
        "plan_sha": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha",
          "type": "string"
        },
        "source": {
          "enum": [
            "cisa-site",
            "cisa-github"
          ],
          "title": "Source",
          "type": "string"
        },
        "surface": {
          "enum": [
            "cli",
            "gui"
          ],
          "title": "Surface",
          "type": "string"
        },
        "url": {
          "maxLength": 512,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "source",
        "url",
        "plan_sha",
        "granted_at",
        "surface"
      ],
      "title": "ConsentRecord",
      "type": "object"
    }
  },
  "$id": "https://patchtrace.local/schemas/kev/1/KevCatalogMeta.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authenticity": {
      "enum": [
        "tls-allowlisted-host",
        "unverified-local-file"
      ],
      "title": "Authenticity",
      "type": "string"
    },
    "catalog_version": {
      "pattern": "^[!-~](?:[ -~]{0,30}[!-~])?$",
      "title": "Catalog Version",
      "type": "string"
    },
    "consent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConsentRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "content_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "contract": {
      "const": "kev/1",
      "default": "kev/1",
      "title": "Contract",
      "type": "string"
    },
    "count": {
      "maximum": 20000,
      "minimum": 1,
      "title": "Count",
      "type": "integer"
    },
    "date_released": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Date Released",
      "type": "string"
    },
    "entry_count": {
      "maximum": 20000,
      "minimum": 1,
      "title": "Entry Count",
      "type": "integer"
    },
    "file_name": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Name"
    },
    "final_url": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Url"
    },
    "license": {
      "const": "CC0-1.0",
      "default": "CC0-1.0",
      "title": "License",
      "type": "string"
    },
    "parser_version": {
      "const": 1,
      "default": 1,
      "title": "Parser Version",
      "type": "integer"
    },
    "raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Sha256",
      "type": "string"
    },
    "raw_size": {
      "maximum": 16777216,
      "minimum": 1,
      "title": "Raw Size",
      "type": "integer"
    },
    "retrieved_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Retrieved At",
      "type": "string"
    },
    "skipped_entries": {
      "default": 0,
      "maximum": 20000,
      "minimum": 0,
      "title": "Skipped Entries",
      "type": "integer"
    },
    "snapshot_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source": {
      "enum": [
        "cisa-site",
        "cisa-github",
        "local-import"
      ],
      "title": "Source",
      "type": "string"
    },
    "source_url": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Url"
    },
    "unknown_fields": {
      "default": [],
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Unknown Fields",
      "type": "array"
    },
    "warnings": {
      "default": [],
      "items": {
        "maxLength": 200,
        "minLength": 0,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "raw_sha256",
    "raw_size",
    "content_digest",
    "catalog_version",
    "date_released",
    "count",
    "entry_count",
    "source",
    "retrieved_at",
    "authenticity"
  ],
  "title": "KevCatalogMeta",
  "type": "object"
}
