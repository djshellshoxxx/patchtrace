+    text = f'check the caller{ESC}[2J{RLO}\nnext line'
+    flags = [] if kind == 'note' else ['--kind', kind]  # note is the default
+    code, envelope, _ = result(capsys, 'review', 'note', project, '--target', target, '--text', text, *flags)
+    after = dump(project)
