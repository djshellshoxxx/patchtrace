{
  "contract": "suite/1",
  "suite": "cwe-patterns",
  "project": "ringbuf",
  "license_spdx": "MIT",
  "summary": "Fixed-slot record ring over a caller-provided byte array. v1 trusts the payload length, so a record longer than the 30-byte slot payload writes past its slot and past the array (CWE-787); v2 adds the bounds check, v3 is a behaviour-preserving refactor of v2, v2c tightens the limit constant.",
  "versions": ["v1", "v2", "v3", "v2c"],
  "build": {"kind": "freestanding-dll", "defines": []},
  "pairs": [
    {
      "old": "v1",
      "new": "v2",
      "intent": "CWE-787 fix: rb_push rejects payloads longer than the slot payload capacity (new helper rb_payload_limit) and counts them as dropped; the unchecked rb_push_fast path is removed; rb_can_push is added for callers that want to pre-check.",
      "truth": [
        {"function": "rb_push", "label": "changed", "kind": "bounds-check-added", "notes": "CWE-787: len was never compared with the 30-byte slot payload; a longer record overran its slot (and the caller array from the last slot). v2 returns RB_ERR_SIZE for len > rb_payload_limit()."},
        {"function": "rb_payload_limit", "label": "added", "taxonomy": ["N7"], "notes": "new tiny helper returning the slot payload capacity (30)"},
        {"function": "rb_can_push", "label": "added", "notes": "new public pre-check predicate; no existing caller uses it"},
        {"function": "rb_push_fast", "label": "removed", "taxonomy": ["N1", "N7"], "notes": "unchecked duplicate of rb_push dropped together with the fix"},
        {"function": "rb_copy", "label": "same", "taxonomy": ["N3"]},
        {"function": "rb_fill", "label": "same", "taxonomy": ["N3"]},
        {"function": "rb_load_len", "label": "same"},
        {"function": "rb_store_len", "label": "same"},
        {"function": "rb_slot_ptr", "label": "same"},
        {"function": "rb_init", "label": "same"},
        {"function": "rb_reset", "label": "same"},
        {"function": "rb_capacity", "label": "same"},
        {"function": "rb_count", "label": "same"},
        {"function": "rb_is_empty", "label": "same"},
        {"function": "rb_is_full", "label": "same"},
        {"function": "rb_pop", "label": "same"},
        {"function": "rb_peek_len", "label": "same"},
        {"function": "rb_drop", "label": "same"},
        {"function": "rb_push_str", "label": "same", "taxonomy": ["N2"]},
        {"function": "rb_push_u32", "label": "same", "taxonomy": ["N2"]},
        {"function": "rb_drain", "label": "same"},
        {"function": "rb_pending_bytes", "label": "same"},
        {"function": "rb_checksum", "label": "same"},
        {"function": "rb_stat_pushed", "label": "same", "taxonomy": ["N1"]},
        {"function": "rb_stat_popped", "label": "same", "taxonomy": ["N1"]},
        {"function": "rb_stat_dropped", "label": "same", "taxonomy": ["N1"]},
        {"function": "rb_clear_stats", "label": "same"}
      ]
    },
    {
      "old": "v2",
      "new": "v3",
      "intent": "Behaviour-preserving refactor of v2: loop style, parameter/local renames, independent statements reordered, lifetime-counter getters moved earlier in the file.",
      "truth": [
        {"function": "rb_copy", "label": "cosmetic", "taxonomy": ["N3"], "notes": "for loop rewritten as a pointer-walking while loop"},
        {"function": "rb_fill", "label": "cosmetic", "taxonomy": ["N3"], "notes": "parameter value->byte, index i->k, i++ -> ++k"},
        {"function": "rb_init", "label": "cosmetic", "notes": "parameter r->ring, counter resets reordered, final slots==0 test folded into a ternary"},
        {"function": "rb_pop", "label": "cosmetic", "notes": "local slot->src; counter updates reordered (independent statements)"},
        {"function": "rb_drop", "label": "cosmetic", "notes": "counter updates reordered (independent statements)"},
        {"function": "rb_push_str", "label": "cosmetic", "taxonomy": ["N2"], "notes": "local n->len, indexing rewritten as *(text + len), n++ -> ++len"},
        {"function": "rb_push_u32", "label": "cosmetic", "taxonomy": ["N2"], "notes": "byte stores emitted from the high byte down (independent statements)"},
        {"function": "rb_drain", "label": "cosmetic", "notes": "while-with-assignment loop rewritten as for(;;) with an inner break"},
        {"function": "rb_pending_bytes", "label": "cosmetic", "notes": "for loop rewritten as a while loop"},
        {"function": "rb_checksum", "label": "cosmetic", "notes": "sum1/sum2 -> a/b, i/j -> n/k"},
        {"function": "rb_load_len", "label": "same"},
        {"function": "rb_store_len", "label": "same"},
        {"function": "rb_slot_ptr", "label": "same"},
        {"function": "rb_reset", "label": "same"},
        {"function": "rb_capacity", "label": "same"},
        {"function": "rb_count", "label": "same"},
        {"function": "rb_is_empty", "label": "same"},
        {"function": "rb_is_full", "label": "same"},
        {"function": "rb_payload_limit", "label": "same"},
        {"function": "rb_can_push", "label": "same"},
        {"function": "rb_push", "label": "same"},
        {"function": "rb_peek_len", "label": "same"},
        {"function": "rb_stat_pushed", "label": "same", "taxonomy": ["N1", "N5"]},
