{
  "contract": "suite/1",
  "suite": "cwe-patterns",
  "project": "namefield",
  "license_spdx": "MIT",
  "summary": "Table of fixed-width named records in a caller-provided byte array. v1 has two off-by-one comparisons: nf_set_name accepts a 16-character name for a 16-byte field and then writes the terminator one byte past it, and nf_get accepts idx == count and hands out the slot just past the live records (off-by-one, CWE-193); v2 changes both '>' to '>='; v3 is a behaviour-preserving refactor of v2; v2c tightens the name-length constant.",
  "versions": ["v1", "v2", "v3", "v2c"],
  "build": {"kind": "freestanding-dll", "defines": []},
  "pairs": [
    {
      "old": "v1",
      "new": "v2",
      "intent": "CWE-193 fix: nf_set_name rejects len >= 16 (so the terminator always fits) and nf_get rejects idx >= count; the buggy convenience accessor nf_last (nf_get(tab, count)) is removed and nf_in_range is added.",
      "truth": [
        {"function": "nf_set_name", "label": "changed", "kind": "comparison-change", "taxonomy": ["N6"], "notes": "CWE-193: \"len > 16\" admitted len == 16, so name[len] = 0 wrote one byte past the 16-byte name field; v2 uses \"len >= 16\"."},
        {"function": "nf_get", "label": "changed", "kind": "comparison-change", "taxonomy": ["N6"], "notes": "CWE-193: \"idx > count\" admitted idx == count, returning the first unused slot (past the array when the table is full); v2 uses \"idx >= count\"."},
        {"function": "nf_in_range", "label": "added", "taxonomy": ["N7"], "notes": "new predicate: idx < count"},
        {"function": "nf_last", "label": "removed", "taxonomy": ["N7", "N2"], "notes": "accessor that asked nf_get for index == count, which only worked because of the bug"},
        {"function": "nf_len", "label": "same"},
        {"function": "nf_copy", "label": "same"},
        {"function": "nf_streq", "label": "same"},
        {"function": "nf_swap", "label": "same"},
