    {
      "old": "v2",
      "new": "v3",
      "intent": "Behaviour-preserving refactor of v2: loop forms, renames, hoisted locals, independent statements reordered, and the flag helpers moved above the table code.",
      "truth": [
        {"function": "nf_len", "label": "cosmetic", "notes": "index scan replaced by a pointer scan"},
        {"function": "nf_copy", "label": "cosmetic", "notes": "for loop rewritten as a counting-down pointer walk"},
        {"function": "nf_streq", "label": "cosmetic", "notes": "i->k"},
        {"function": "nf_swap", "label": "cosmetic", "notes": "scalar swaps reordered, for loop rewritten as while"},
